    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>ElfPrimacy</meme>
    <otherMeme>MinotaurPrimacy</otherMeme>
    <naturalGoodwillOffset>-40</naturalGoodwillOffset>
  </GoodwillSituationDef>
  
</Defs>
