<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  
  
  <GoodwillSituationDef>
    <defName>ElfPrimacy_ElfPrimacy</defName>
    <label>elf primacy agreement</label>
    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>ElfPrimacy</meme>
    <otherMeme>ElfPrimacy</otherMeme>
    <naturalGoodwillOffset>25</naturalGoodwillOffset>
  </GoodwillSituationDef>
  
  <GoodwillSituationDef>
    <defName>ElfPrimacy_NaturePrimacy</defName>
    <label>elf primacy vs nature primacy</label>
    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>ElfPrimacy</meme>
    <otherMeme>NaturePrimacy</otherMeme>
    <naturalGoodwillOffset>10</naturalGoodwillOffset>
  </GoodwillSituationDef>
  
   <GoodwillSituationDef>
    <defName>DrowPrimacy_DrowPrimacy</defName>
    <label>drow primacy agreement</label>
    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>DrowPrimacy</meme>
    <otherMeme>DrowPrimacy</otherMeme>
    <naturalGoodwillOffset>10</naturalGoodwillOffset>
  </GoodwillSituationDef>


  <!-- Disagreement -->


<GoodwillSituationDef>
    <defName>ElfPrimacy_HumanPrimacy</defName>
    <label>elf primacy vs human primacy</label>
    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>ElfPrimacy</meme>
    <otherMeme>HumanPrimacy</otherMeme>
    <naturalGoodwillOffset>-20</naturalGoodwillOffset>
</GoodwillSituationDef>
  
 <GoodwillSituationDef MayRequire="Aquiles.Dwarves">
    <defName>ElfPrimacy_DwarvenPrimacy</defName>
    <label>elf primacy vs dwarf primacy</label>
    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>ElfPrimacy</meme>
    <otherMeme>DwarvenPrimacy</otherMeme>
    <naturalGoodwillOffset>-40</naturalGoodwillOffset>
  </GoodwillSituationDef>

<GoodwillSituationDef>
    <defName>ElfPrimacy_DrowPrimacy</defName>
    <label>elf primacy vs drow primacy</label>
    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>ElfPrimacy</meme>
    <otherMeme>DrowPrimacy</otherMeme>
    <naturalGoodwillOffset>-100</naturalGoodwillOffset>
  </GoodwillSituationDef>
  
  <GoodwillSituationDef>
    <defName>DrowPrimacy_All</defName>
    <label>dark elves above anything else</label>
    <workerClass>GoodwillSituationWorker_MemeCompatibility</workerClass>
    <meme>DrowPrimacy</meme>
    <versusAll>true</versusAll>
    <naturalGoodwillOffset>-50</naturalGoodwillOffset>
  </GoodwillSituationDef>

  
  <GoodwillSituationDef MayRequire="Aquiles.Humanoids">
    <defName>ElfPrimacy_MinotaurPrimacy</defName>
