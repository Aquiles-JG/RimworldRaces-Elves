<?xml version="1.0" encoding="utf-8"?>
<Defs>
 
<FactionDef Name="Aq_ElfFactionBase" ParentName="FactionBase" Abstract="True">
	<pawnSingular>elf</pawnSingular>
	<pawnsPlural>elves</pawnsPlural>
	<categoryTag>Elf</categoryTag>
	<settlementGenerationWeight>1</settlementGenerationWeight>
	<listOrderPriority>20</listOrderPriority>
    <requiredCountAtGameStart>1</requiredCountAtGameStart>
    <canStageAttacks>true</canStageAttacks>
    <factionIconPath>World/HighElves</factionIconPath>
    <techLevel>Medieval</techLevel>
    <factionNameMaker>NamerFactionTribal</factionNameMaker>
    <settlementNameMaker>Aq_NamerFactionBaseElfHigh</settlementNameMaker>
    <allowedCultures>
    	<li MayRequire="Ludeon.RimWorld.Ideology">LightofIriss</li>
	</allowedCultures>
	<requiredMemes>
      <li MayRequire="Ludeon.RimWorld.Ideology">ElfPrimacy</li>
    </requiredMemes>
	<disallowedPrecepts>
      <li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Honorable</li>
      <li MayRequire="Ludeon.RimWorld.Ideology">Slavery_Acceptable</li>
    </disallowedPrecepts>
    <structureMemeWeights>
      <Structure_Animist MayRequire="Ludeon.RimWorld.Ideology">1</Structure_Animist>
      <Structure_TheistEmbodied MayRequire="Ludeon.RimWorld.Ideology">4</Structure_TheistEmbodied>
      <Structure_TheistAbstract MayRequire="Ludeon.RimWorld.Ideology">2</Structure_TheistAbstract>
    </structureMemeWeights>
    <xenotypeSet>
      <xenotypeChances>
        <Aq_Elf>999</Aq_Elf>
      </xenotypeChances>
    </xenotypeSet>
	<backstoryFilters>
      <li>
        <categories>
          <li>Elf</li>
        </categories>
      </li>
    </backstoryFilters>
 	<leaderTitle>emperor</leaderTitle>
	<caravanTraderKinds>
    	<li>Elf_Caravan_BulkGoods</li>
    	<li>Elf_Caravan_Exotic</li>
	</caravanTraderKinds>
	<visitorTraderKinds>
    	<li>Aq_Visitor_Elf</li>
	</visitorTraderKinds>
	<baseTraderKinds>
    	<li>Base_Elf_Standard</li>
	</baseTraderKinds>
	<allowedArrivalTemperatureRange>-40~40</allowedArrivalTemperatureRange>
	<raidCommonalityFromPointsCurve>
    	<points>
    	<li>(0, 1)</li>
    	</points>
	</raidCommonalityFromPointsCurve>
	<raidLootMaker>ElfRaidLootMaker</raidLootMaker>
	<maxPawnCostPerTotalPointsCurve>
      <points>
        <li>(0,35)</li>
        <li>(70, 50)</li>
        <li>(800, 100)</li>
        <li>(1300, 150)</li>
        <li>(100000, 10000)</li>
      </points>
	</maxPawnCostPerTotalPointsCurve>
	<pawnGroupMakers>
      <li>
        <kindDef>Peaceful</kindDef>
        <options>
          <Aq_ElfWatcherHigh>40</Aq_ElfWatcherHigh>
          <ElfAlly>10</ElfAlly>
          <Aq_ElfChampionHigh>7.5</Aq_ElfChampionHigh>
          <Aq_ElfGuardHigh>30</Aq_ElfGuardHigh>
          <Aq_ElfArcherHigh>10</Aq_ElfArcherHigh>
          <Aq_ElfLord>2.5</Aq_ElfLord>
        </options>
      </li>
      <li>
        <kindDef>Combat</kindDef>
        <commonality>8</commonality>
        <options>
          <ElfAlly>15</ElfAlly>
          <Aq_ElfWatcherHigh>40</Aq_ElfWatcherHigh>
          <Aq_ElfGuardHigh>40</Aq_ElfGuardHigh>
          <Aq_ElfArcherHigh>5</Aq_ElfArcherHigh>
        </options>
      </li>
       <li>
        <!-- Elite troops-->
        <kindDef>Combat</kindDef>
        <commonality>2</commonality>
        <options>
          <Aq_ElfGuardHigh>50</Aq_ElfGuardHigh>
          <Aq_ElfArcherHigh>30</Aq_ElfArcherHigh>
          <Aq_ElfChampionHigh>15</Aq_ElfChampionHigh>
          <Aq_ElfLord>5</Aq_ElfLord>
        </options>
      </li>
      <li>
        <kindDef>Trader</kindDef>
        <traders>
          <Aq_ElfTraderHigh>1</Aq_ElfTraderHigh>
        </traders>
        <carriers>
          <Muffalo>6</Muffalo>
          <Yak>5</Yak>
          <Alpaca>2</Alpaca>
          <Elephant>1</Elephant>
        </carriers>
        <guards>
          <Aq_ElfWatcherHigh>40</Aq_ElfWatcherHigh>
          <Aq_ElfChampionHigh>5</Aq_ElfChampionHigh>
          <Aq_ElfGuardHigh>40</Aq_ElfGuardHigh>
          <Aq_ElfArcherHigh>15</Aq_ElfArcherHigh>
        </guards>
      </li>
      <li>
        <kindDef>Settlement</kindDef>
        <options>
          <Aq_ElfWatcherHigh>40</Aq_ElfWatcherHigh>
          <ElfAlly>5</ElfAlly>
          <Aq_ElfChampionHigh>7.5</Aq_ElfChampionHigh>
          <Aq_ElfGuardHigh>30</Aq_ElfGuardHigh>
          <Aq_ElfArcherHigh>15</Aq_ElfArcherHigh>
          <Aq_ElfLord>2.5</Aq_ElfLord>
        </options>
      </li>
       <li MayRequire="Ludeon.RimWorld.Ideology">
        	<kindDef>Miners</kindDef>
        	<commonality>1</commonality>
        	<options>
          		<Aq_HighElf_Miner>1</Aq_HighElf_Miner>
        	</options>
  		</li>
     		<li MayRequire="Ludeon.RimWorld.Ideology">
        	<kindDef>Loggers</kindDef>
        	<commonality>1</commonality>
        	<options>
          		<Aq_HighElf_Logger>1</Aq_HighElf_Logger>
        	</options>
      	</li>
      		<li MayRequire="Ludeon.RimWorld.Ideology">
        	<kindDef>Farmers</kindDef>
        	<commonality>1</commonality>
        	<options>
          		<Aq_HighElf_Farmer>1</Aq_HighElf_Farmer>
        	</options>
       	</li>
    </pawnGroupMakers> 
	<settlementTexturePath>World/MedievalSettlement</settlementTexturePath>
	<modExtensions>
      <li Class="VFECore.FactionDefExtension">
        <allowedBiomes>
          <li>BorealForest</li>
          <li>TropicalRainforest</li>
          <li>Tundra</li>
          <li>TemperateForest</li>
        </allowedBiomes>
      </li>
	</modExtensions>
</FactionDef>


<FactionDef ParentName="Aq_ElfFactionBase">
    <defName>Aq_ElfFactionHigh</defName>
    <label>hidden empire</label>
    <description>While largely populated by the Iriss, or gray elves (named for their wisdom), this collective organization of many elves has taken it upon their shoulders to intervene in affairs on behalf of other kindred. Their realms stand as strongholds for well trained troops, as well as locales to recruit agents, and fellowships, for their cause.</description>
    <colorSpectrum>
    	<li>(228, 179, 51)</li>
    	<li>(228, 179, 21)</li>
    </colorSpectrum>
    <fixedName>Iriss Empire</fixedName>
    <maxConfigurableAtWorldCreation>9999</maxConfigurableAtWorldCreation>
    <configurationListOrderPriority>64</configurationListOrderPriority>
    <allowedMemes>
    	<li MayRequire="Ludeon.RimWorld.Ideology">Collectivist</li>
    	<li MayRequire="Ludeon.RimWorld.Ideology">AnimalPersonhood</li>
    	<li MayRequire="Ludeon.RimWorld.Ideology">FleshPurity</li>
    	<li MayRequire="Ludeon.RimWorld.Ideology">TreeConnection</li>
    </allowedMemes>
</FactionDef>
  
<ThingSetMakerDef>
    <defName>ElfRaidLootMaker</defName>
    <root Class="ThingSetMaker_MarketValue">
      <fixedParams>
        <filter>
          <thingDefs>
          	<li>Silver</li>
            <li>MedicineHerbal</li>
            <li>DE_Waybread</li>
          </thingDefs>
        </filter>
      </fixedParams>
    </root>
</ThingSetMakerDef>

</Defs>