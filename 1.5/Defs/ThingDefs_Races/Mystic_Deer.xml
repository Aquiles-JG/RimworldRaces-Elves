	  <wildBiomes>
		<TemperateSwamp>0.05</TemperateSwamp>
		<BorealForest>0.1</BorealForest>
		<Tundra>0.1</Tundra>
		<ColdBog>0.05</ColdBog>
	  </wildBiomes>
