<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<HediffDef Name="Drow_PainstopperBase" Abstract="True">
    <defaultLabelColor>(128, 0, 128)</defaultLabelColor>
    <label>painkillers</label>
    <description>A strange substance beneath the plates protects the skin from pain.</description>
</HediffDef>


  <HediffDef ParentName="Drow_PainstopperBase">
    <defName>Drow_Painstopper</defName>
    <stages>
      <li>
        <label>Armour</label>
        <painOffset>-0.2</painOffset>
      </li>
    </stages>
  </HediffDef>
  
   <HediffDef ParentName="Drow_PainstopperBase">
    <defName>Drow_HighPainstopper</defName>
    <stages>
      <li>
        <label>Armour</label>
        <painOffset>-0.2</painOffset>
        <totalBleedFactor>0.5</totalBleedFactor>
      </li>
    </stages>
  </HediffDef>
  
  <HediffDef ParentName="Drow_PainstopperBase">
    <defName>Drow_HeavyPainstopper</defName>
    <stages>
      <li>
        <label>Armour</label>
        <painOffset>-0.4</painOffset>
        <totalBleedFactor>0.25</totalBleedFactor>
      </li>
    </stages>
  </HediffDef>
  
   <HediffDef ParentName="DiseaseBase">
    <defName>Paralysis</defName>
    <label>paralysis</label>
    <labelNoun>paralysis</labelNoun>
    <description>Paralysis caused by venom.</description>
	<maxSeverity>1.0</maxSeverity>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <disappearsAfterTicks>1000~1500</disappearsAfterTicks>
      </li>
    </comps>
    <stages>
	   <li>
        <label>minor</label>
        <becomeVisible>true</becomeVisible>
      </li>
      <li>
		<minSeverity>0.9</minSeverity>
        <capMods>
          <li>
            <capacity>Moving</capacity>
            <setMax>0.05</setMax>
          </li>
        </capMods>
      </li>
    </stages>
  </HediffDef>
  
  <HediffDef ParentName="InjuryBase">
		<defName>VAE_OpenWound</defName>
		<label>open wound</label>
		<description>An open wound.</description>
		<labelNoun>an open wound</labelNoun>
		<comps>
			<li Class="HediffCompProperties_TendDuration">
				<labelTendedWell>bandaged</labelTendedWell>
				<labelTendedWellInner>sutured</labelTendedWellInner>
				<labelSolidTendedWell>set</labelSolidTendedWell>
			</li>
			<li Class="HediffCompProperties_Infecter">
				<infectionChance>0.15</infectionChance>
			</li>
			<li Class="HediffCompProperties_GetsPermanent">
				<permanentLabel>stab scar</permanentLabel>
			</li>
		</comps>
		<injuryProps>
			<painPerSeverity>0.0125</painPerSeverity>
			<averagePainPerSeverityPermanent>0.00625</averagePainPerSeverityPermanent>
			<bleedRate>0.06</bleedRate>
			<canMerge>false</canMerge>
			<destroyedLabel>Cut off</destroyedLabel>
			<destroyedOutLabel>Cut out</destroyedOutLabel>
		</injuryProps>
	</HediffDef>
	
	<HediffDef ParentName="DiseaseBase">
		<defName>Aq_Vomiting</defName>
		<label>uncontrollable vomiting</label>
		<description>The poisonous claws of the troll has caused an uncontrollable nausea.</description>
		<scenarioCanAdd>false</scenarioCanAdd>

		<comps>
			<li Class="HediffCompProperties_SeverityPerDay">
				<severityPerDay>-1</severityPerDay>
			</li>
		</comps>
		<stages>
			<li>
				<label>minor</label>
				<vomitMtbDays>0.1</vomitMtbDays>
				<painOffset>0.2</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.9</postFactor>
					</li>

				</capMods>
			</li>
			<li>
				<label>major</label>
				<minSeverity>0.4</minSeverity>
				<vomitMtbDays>0.05</vomitMtbDays>
				<painOffset>0.4</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.75</postFactor>
					</li>

				</capMods>
			</li>
			<li>
				<label>extreme</label>
				<minSeverity>0.8</minSeverity>
				<vomitMtbDays>0.01</vomitMtbDays>
				<painOffset>0.5</painOffset>
				<capMods>
					<li>
						<capacity>Consciousness</capacity>
						<postFactor>0.6</postFactor>
					</li>
					<li>
						<capacity>Moving</capacity>
						<postFactor>0.75</postFactor>
					</li>
					<li>
						<capacity>Manipulation</capacity>
						<postFactor>0.75</postFactor>
					</li>

				</capMods>
			</li>
		</stages>
	</HediffDef>
	
</Defs>