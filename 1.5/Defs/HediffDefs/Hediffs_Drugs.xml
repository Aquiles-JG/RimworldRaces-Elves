<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Alcohol-->
<HediffDef>
	<defName>PeppermintHigh</defName>
	<label>peppermint liquor high</label>
	<labelNoun>a peppermint liquor high</labelNoun>
	<description>Drank some peppermint liquor.</description>
	<hediffClass>Hediff_Alcohol</hediffClass>
	<defaultLabelColor>(1,0,0.5)</defaultLabelColor>
	<scenarioCanAdd>true</scenarioCanAdd>
	<isBad>false</isBad>
	<comps>
		<li Class="HediffCompProperties_SeverityPerDay">
			<severityPerDay>-0.75</severityPerDay>
			<showHoursToRecover>true</showHoursToRecover>
		</li>
	</comps>
	<stages>
	  <li>
		<restFallFactor>0.9</restFallFactor>
		<statOffsets>
			<SocialImpact>0.15</SocialImpact>
			<TradePriceImprovement>0.15</TradePriceImprovement>
		</statOffsets>		
	   </li>
	</stages>
</HediffDef>

<!-- Venoms and Ointments-->

<HediffDef>
    <defName>VenomTreated</defName>
    <label>treated with venoms</label>
    <description>A therapeutical venom is in the bloodstream. No use for another dose right now.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <comps>
      <li Class="HediffCompProperties_Disappears">
        <showRemainingTime>true</showRemainingTime>
      </li>
    </comps>
</HediffDef>

 <HediffDef>
    <defName>Aq_Convalescent</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>convalescent</label>
    <description>An after-effect of a venom. The effects are bothersome, but the prelude for a full recovery.</description>
    <defaultLabelColor>(252, 209, 42)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
		<li Class="HediffCompProperties_SeverityPerDay">
			<severityPerDay>-0.5</severityPerDay>
			<showHoursToRecover>true</showHoursToRecover>
		</li>
	</comps>
    <stages>
      <li>
        <hungerRateFactor>1.5</hungerRateFactor>
        <painOffset>0.1</painOffset>
        <vomitMtbDays>1.0</vomitMtbDays>
        <capMods>
          <li>
            <capacity>Consciousness</capacity>
            <postFactor>0.8</postFactor>
          </li>
          <li>
            <capacity>Manipulation</capacity>
            <postFactor>0.8</postFactor>
          </li>
        </capMods>
        <statFactors>
          <RestFallRateFactor>1.5</RestFallRateFactor>
        </statFactors>
      </li>
    </stages>
  </HediffDef>

<HediffDef>
    <defName>AntiToxicHigh</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>anti-toxic venom</label>
    <description>Anti-toxic substances in the bloodstream.</description>
    <defaultLabelColor>(0,1,0.5)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.0</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-0.23</severityPerDay>
      </li>
    </comps>
    <stages>
      <li>
        <statOffsets>
          <ToxicResistance>1</ToxicResistance>
        </statOffsets>
      </li>
    </stages>
</HediffDef>

<HediffDef>
    <defName>Aq_AloeOintmentHigh</defName>
    <hediffClass>HediffWithComps</hediffClass>
    <label>aloe vera balm</label>
    <description>aloe balm effect</description>
    <defaultLabelColor>(0.4, 1, 0)</defaultLabelColor>
    <scenarioCanAdd>true</scenarioCanAdd>
    <maxSeverity>1.5</maxSeverity>
    <isBad>false</isBad>
    <comps>
      <li Class="HediffCompProperties_SeverityPerDay">
        <severityPerDay>-1.05</severityPerDay>
      </li>
      <li Class="Regeneration.HediffCompProperties_Regen">
        <regenHoursMin>5</regenHoursMin>
        <regenHoursMax>6</regenHoursMax>
        <regenHealVal>2</regenHealVal>
        <cureScars>true</cureScars>
        <includeBrainScar>false</includeBrainScar>
      </li>
    </comps>
    <stages>
      <li>
        <lifeThreatening>false</lifeThreatening>
        <painFactor>0.95</painFactor>
      </li>
    </stages>
  </HediffDef>
	
</Defs>