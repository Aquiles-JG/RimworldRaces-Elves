<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
  <TraitDef>
    <defName>ReveredDrow</defName>
    <commonality>0.001</commonality>
    <forcedPassions>
			<li>Social</li>
		</forcedPassions>
    <degreeDatas>
      <li>
        <label>revered</label>
        <description>Even in a harsh society like the dark elves, some individuals have the devotion of the rest. [PAWN_nameDef] is revered among the drow as a holy dark elf. Every time [PAWN_pronoun] speaks, everybody listens.</description>
        <allowedMeditationFocusTypes><li>Morbid</li></allowedMeditationFocusTypes>
        <statOffsets>
					<MentalBreakThreshold>-0.1</MentalBreakThreshold>
					<SocialImpact>0.40</SocialImpact>
					<NegotiationAbility>0.2</NegotiationAbility>
		</statOffsets>
		<skillGains>
          <Social>5</Social>
          <Intellectual>1</Intellectual>
        </skillGains>
      </li>
    </degreeDatas>
    <conflictingTraits>
    </conflictingTraits>
    <requiredWorkTags>
      <li>Social</li>
    </requiredWorkTags>	
  </TraitDef>
  
  <TraitDef>
		<defName>DeathGiftDrow</defName>
		<commonality>0.1</commonality>
		<degreeDatas>
			<li>
				<label>death gift</label>
				<description>{PAWN_nameDef} has a knack for organic alchemy, and is quite an efficient worker when brewing poisons and venoms.</description>
				<allowedMeditationFocusTypes><li>Morbid</li></allowedMeditationFocusTypes>
				<statOffsets>
					<DrugCookingSpeed>0.2</DrugCookingSpeed>
					<DrugSynthesisSpeed>0.2</DrugSynthesisSpeed>
				</statOffsets>
				<skillGains>
					<Cooking>1</Cooking>
					<Crafting>2</Crafting>
				</skillGains>
			</li>
		</degreeDatas>
		<requiredWorkTypes>
			<li>Cooking</li>
			<li>Crafting</li>
		</requiredWorkTypes>
		<conflictingTraits>
			<li>SlowLearner</li>
		</conflictingTraits>
  </TraitDef>
	
  <TraitDef>
    <defName>ShootingAccuracyDrow</defName>
    <commonality>0.1</commonality>
    <forcedPassions>
			<li>Shooting</li>
		</forcedPassions>
    <degreeDatas>
      <li>
        <label>killer instinct</label>
        <description>[PAWN_nameDef] came from an especially dangerous world and is conditioned to kill before [PAWN_pronoun]'s killed. {PAWN_possessive} accuracy is increased.</description>
        <allowedMeditationFocusTypes><li>Morbid</li></allowedMeditationFocusTypes>
        <statOffsets>
          <AimingDelayFactor>-0.1</AimingDelayFactor>
          <ShootingAccuracyPawn>4.0</ShootingAccuracyPawn>
        </statOffsets>
		  <skillGains>
          <Shooting>4</Shooting>
        </skillGains>
      </li>
    </degreeDatas>
    <conflictingTraits>
      <li>Brawler</li>
      <li>Wimp</li>
	  <li>BrawlerDrow</li>
    </conflictingTraits>
     <conflictingPassions>
      <li>Melee</li>
    </conflictingPassions>
	<!-- {PAWN_possessive} -->
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
	
  </TraitDef>
  
    <TraitDef>
    <defName>BrawlerDrow</defName>
	  <commonality>0.1</commonality>
	  <forcedPassions>
			<li>Melee</li>
		</forcedPassions>
    <degreeDatas>
      <li>
        <label>fists of fury</label>
        <description>{PAWN_nameDef} has spent far too much time fighting to stay alive up close and personal. [PAWN_pronoun] knows how to make hits connect, and  how to avoid them.</description>
        <allowedMeditationFocusTypes><li>Morbid</li></allowedMeditationFocusTypes>
        <statOffsets>
          <MeleeHitChance>3</MeleeHitChance>
		  <MeleeDodgeChance>10</MeleeDodgeChance>
        </statOffsets>
        <skillGains>
          <Melee>4</Melee>
        </skillGains>
        <disallowedInspirations>
          <li>Frenzy_Shoot</li>
        </disallowedInspirations>
      </li>
    </degreeDatas>
    <conflictingTraits>
			<li>ShootingAccuracy</li>
			<li>Wimp</li>
			<li>ShootingAccuracyDrow</li>
    </conflictingTraits>
     <conflictingPassions>
      <li>Shooting</li>
    </conflictingPassions>
    <requiredWorkTags>
      <li>Violent</li>
    </requiredWorkTags>
  </TraitDef>

  <TraitDef>
    <defName>NegotiatorDrow</defName>
	  <commonality>0.15</commonality>
	  <forcedPassions>
			<li>Social</li>
		</forcedPassions>
    <degreeDatas>
      <li>
        <label>silk gauntlet</label>
        <description>{PAWN_nameDef} knows the drow way of doing bussiness: Seduction and Intimidation.</description>
        <statOffsets>
          <NegotiationAbility>0.25</NegotiationAbility>
          <TradePriceImprovement>0.15</TradePriceImprovement>
        </statOffsets>
        <skillGains>
          <Social>2</Social>
        </skillGains>
      </li>
    </degreeDatas>
    <conflictingTraits>			
    </conflictingTraits>
    <requiredWorkTags>
      <li>Social</li>
    </requiredWorkTags>
  </TraitDef>
  
</Defs>