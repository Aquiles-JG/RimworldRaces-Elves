<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <TraderKindDef>
    <defName>Base_Elf_Standard</defName>
    <stockGenerators>
      <!-- Resources -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>1000~4000</countRange>
      </li>
       <li Class="StockGenerator_SingleDef">
        <thingDef>Hay</thingDef>
       	<countRange>40~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Steel</thingDef>
        <countRange>200~600</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>40~400</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Gold</thingDef>
        <countRange>25~150</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>MedicalSupplies</tradeTag>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
        <thingDefCountRange>1~3</thingDefCountRange>
        <totalPriceRange>250~600</totalPriceRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineHerbal</thingDef>
       	<countRange>20~50</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
        <thingDefCountRange>1~2</thingDefCountRange>
        <totalPriceRange>400~800</totalPriceRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>ResourcesRaw</categoryDef>
        <thingDefCountRange>2~4</thingDefCountRange>
        <totalPriceRange>400~800</totalPriceRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodRaw</categoryDef>
        <excludedCategories><li>EggsFertilized</li></excludedCategories>
        <thingDefCountRange>2~4</thingDefCountRange>
        <totalPriceRange>400~800</totalPriceRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodMeals</categoryDef>
        <thingDefCountRange>2~3</thingDefCountRange>
        <countRange>8~24</countRange>
      </li>
     
      <li Class="StockGenerator_Tag">
        <tradeTag>Elvendom</tradeTag>
        <thingDefCountRange>2~3</thingDefCountRange>
        <totalPriceRange>400~1600</totalPriceRange>
        <price>Expensive</price>
      </li>
      <!-- Techprints -->
      <li Class="StockGenerator_Techprints">
        <countChances>
          <li>
            <count>1</count>
            <chance>1</chance>
          </li>
        </countChances>
      </li>
      <!-- Weapons -->
       <li Class="StockGenerator_Tag">
        <tradeTag>ElvenMelee</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>ElvenRanged</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~2</countRange>
      </li>
      <!-- Apparel -->
      <li Class="StockGenerator_Tag">
        <tradeTag>BasicClothing</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~3</countRange>
      </li>
      <!-- Buildings -->
      <li Class="StockGenerator_Category">
        <categoryDef>BuildingsFurniture</categoryDef>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
        <thingDefCountRange>1~3</thingDefCountRange>
        <countRange>1</countRange>
      </li>
      <!-- Exotic -->
      <li Class="StockGenerator_Tag">
        <tradeTag>Artifact</tradeTag>
        <thingDefCountRange>0~3</thingDefCountRange>
        <countRange>1</countRange>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>ExoticMisc</tradeTag>
        <thingDefCountRange>1~3</thingDefCountRange>
        <countRange>1~3</countRange>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
        <excludedThingDefs>
          <li>Luciferium</li> 
          <li>ComponentSpacer</li> 
          <li>MedicineUltratech</li> 
        </excludedThingDefs>
      </li>
      <!-- Animals -->
      <li Class="StockGenerator_Animals">
        <tradeTagsSell>
        	<li>AnimalUncommon</li>
        	<li>AnimalExotic</li>
        </tradeTagsSell>
        <tradeTagsBuy>
        	<li>AnimalUncommon</li>
            <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>1~2</kindCountRange>
        <countRange>2~4</countRange>
      </li>
      <!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>ExoticBuilding</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>MusicalInstrument</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Drugs</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Aq_Gemstones</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Elvendom</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Dwarfdom</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Minoan</tag></li>
    </stockGenerators>
  </TraderKindDef>

</Defs>
