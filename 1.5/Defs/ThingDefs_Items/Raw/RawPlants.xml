<?xml version="1.0" encoding="utf-8"?>
<Defs>
	
  <ThingDef ParentName="RoughPlantBase">
	<defName>Aq_RawPeppermint</defName>
	<label>peppermint leaves</label>
	<description>The green leaves which are processed for essential medical oils.</description>
	<graphicData>
		<texPath>Things/Item/Resource/Raw/PeppermintLeaves</texPath>
	</graphicData>
	<statBases>
		<MarketValue>5.5</MarketValue>
		<Nutrition>0</Nutrition>
		<Flammability>1.3</Flammability>
	</statBases>
	<thingCategories>
		<li>PlantMatter</li>
	</thingCategories>
	<ingestible>
		<preferability>NeverForNutrition</preferability>
		<optimalityOffsetFeedingAnimals>-50</optimalityOffsetFeedingAnimals>
	</ingestible>
	<comps>
		<li Class="CompProperties_Rottable">
			<daysToRotStart>15</daysToRotStart>
			<rotDestroys>true</rotDestroys>
		</li>
	</comps>
  </ThingDef>
	
  <ThingDef ParentName="RoughPlantBase">
	<defName>Aq_AloeLeaves</defName>
	<label>aloe leaves</label>
	<description>Leaves of the aloe vera plant.</description>
	<graphicData>
	  <texPath>Things/Item/Resource/Raw/AloeLeaves</texPath>
	  <graphicClass>Graphic_Single</graphicClass>
	</graphicData>
	<statBases>
	  <MarketValue>1.4</MarketValue>
	  <Nutrition>0.01</Nutrition>
	  <Flammability>0.7</Flammability>
	</statBases>
	<thingCategories>
		<li>PlantMatter</li>
	</thingCategories>
	<ingestible>
	  <preferability>DesperateOnlyForHumanlikes</preferability>
	</ingestible>
	<comps>
	  <li Class="CompProperties_Rottable">
		<daysToRotStart>45</daysToRotStart>
		<rotDestroys>true</rotDestroys>
	  </li>
	</comps>
  </ThingDef>
  
  <ThingDef ParentName="RoughPlantBase">
