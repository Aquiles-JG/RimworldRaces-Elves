<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!-- Repeater Crossbow -->

 <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>DE_bolt_repeater</defName>
    <label>repeater crossbow bolt</label>
    <graphicData>
      <texPath>Things/WeaponRanged/RepeaterCrossbow/DE_arrow_big</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>Arrow</damageDef>
      <damageAmountBase>16</damageAmountBase>
	  <armorPenetrationBase>0.3</armorPenetrationBase>
      <speed>54</speed>
    </projectile>
  </ThingDef>


<ThingDef ParentName="BaseWeaponNeolithic">
    <defName>DE_RepeaterCB</defName>
    <label>drow crossbow</label>
    <description>An incredibly fast repeater crossbow used by assassins mostly. It doesn't fire double shots like the other crossbow, but its armor penetration is unmatched.</description> 
    <graphicData>
      <texPath>Things/WeaponRanged/RepeaterCrossbow/DE_RepeaterCB</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <soundInteract>Bow_Large</soundInteract>
    <costList>
	  <Steel>20</Steel>
	  <Leather_MDeer>10</Leather_MDeer>
    </costList>
     <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>10</costStuffCount>
    <equippedStatOffsets>
    	<HuntingStealth>0.10</HuntingStealth>
    </equippedStatOffsets>
    <techLevel>Medieval</techLevel>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>0.65</Mass>
      <AccuracyTouch>0.68</AccuracyTouch>
      <AccuracyShort>0.86</AccuracyShort>
      <AccuracyMedium>0.82</AccuracyMedium>
      <AccuracyLong>0.32</AccuracyLong>
      <RangedWeapon_Cooldown>1.7</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>DrowRanged</li>
    </weaponTags>
     <weaponClasses>
      <li>Karasti</li>
    </weaponClasses>
    <tradeTags>
        <li>DrowRanged</li>
        <li>Underdark</li>
    </tradeTags>
    <recipeMaker>
	  <recipeUsers>
		<li>FueledSmithy</li>
		<li>ElectricSmithy</li>
	  </recipeUsers>
    <researchPrerequisite>Kara_RangedWeapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <burstShotCount>1</burstShotCount>
        <ticksBetweenBurstShots>25</ticksBetweenBurstShots>
        <defaultProjectile>DE_bolt_repeater</defaultProjectile>
        <warmupTime>2.2</warmupTime>
        <range>24</range>
        <soundCast>DE_CrossbowShot</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <smeltable>true</smeltable>
    <burnableByRecipe>true</burnableByRecipe>
  </ThingDef>
  
  <!-- Double Crossbow -->

