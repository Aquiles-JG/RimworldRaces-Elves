        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <smeltable>true</smeltable>
    <burnableByRecipe>true</burnableByRecipe>
  </ThingDef>




<!-- ==================== Dark Elven Bow ========================== -->

  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>DE_Arrow</defName>
    <label>drow arrow</label>
    <graphicData>
      <texPath>Things/WeaponRanged/Bow/DE_Arrow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <speed>55</speed>
      <damageDef>Arrow</damageDef>
      <stoppingPower>1.1</stoppingPower>
      <armorPenetrationBase>0.2</armorPenetrationBase>
	  <damageAmountBase>20</damageAmountBase>
	  <arcHeightFactor>0.70</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
    </projectile>
	</ThingDef>
  
  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>Kara_Bow</defName>
    <label>drow bow</label>
    <description>A drow longbow. You could think this is only for hunters, but this bow is used also in war, because its excellent accuracy and armor penetration.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/WeaponRanged/Bow/DE_Bow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>1.1</drawSize>
    </graphicData>
    <equippedAngleOffset>-75</equippedAngleOffset>
    <soundInteract>Bow_Large</soundInteract>
    <statBases>
      <WorkToMake>25000</WorkToMake>
      <Mass>1.25</Mass>
      <AccuracyTouch>0.72</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.77</AccuracyMedium>
      <AccuracyLong>0.62</AccuracyLong>
      <RangedWeapon_Cooldown>1.4</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>DrowRanged</li>
    </weaponTags>
    <weaponClasses>
      <li>Karasti</li>
    </weaponClasses>
	 <tradeTags>
	    <li>DrowRanged</li>
        <li>Underdark</li>
     </tradeTags>
    <costList>
		<Plasteel>5</Plasteel>
		<Leather_MDeer>20</Leather_MDeer>
    </costList>
     <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <equippedStatOffsets>
    	<HuntingStealth>0.25</HuntingStealth>
    </equippedStatOffsets>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>DE_Arrow</defaultProjectile>
        <warmupTime>2</warmupTime>
        <range>42</range>
        <soundCast>Bow_Large</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>Kara_RangedWeapons</researchPrerequisite>
      <skillRequirements>
		<Crafting>8</Crafting>
	  </skillRequirements>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
    </recipeMaker>
  </ThingDef>
  
  
</Defs>