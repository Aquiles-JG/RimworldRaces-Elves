    <soundInteract>Bow_Large</soundInteract>
    <costList>
	  <Steel>20</Steel>
	  <Leather_MDeer>15</Leather_MDeer>
    </costList>
     <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>20</costStuffCount>
    <equippedStatOffsets>
    	<HuntingStealth>0.05</HuntingStealth>
    </equippedStatOffsets>
    <techLevel>Medieval</techLevel>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>0.85</Mass>
