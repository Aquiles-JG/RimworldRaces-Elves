<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  
 <CultureDef>
    <defName>LightofIriss</defName>
    <label>Elven</label>
    <description>A broad category describing the beliefs, styles and practices of elven societies.</description>
    <ideoNameMaker MayRequire="Ludeon.RimWorld.Ideology">ElfIdeoNamer</ideoNameMaker>
    <deityNameMaker MayRequire="Ludeon.RimWorld.Ideology">NamerDeityElf</deityNameMaker>
    <deityTypeMaker MayRequire="Ludeon.RimWorld.Ideology">DeityTypeMakerElf</deityTypeMaker>
    <leaderTitleMaker MayRequire="Ludeon.RimWorld.Ideology">NamerLeaderElf</leaderTitleMaker>
    <festivalNameMaker MayRequire="Ludeon.RimWorld.Ideology">ElfNamerFestival</festivalNameMaker> 
    <allowedPlaceTags>
      <li>OriginTribal</li>
    </allowedPlaceTags>
    <iconPath>World/WoodElves</iconPath>
    <iconColor>(0.8, 0.8, 0.8)</iconColor>
