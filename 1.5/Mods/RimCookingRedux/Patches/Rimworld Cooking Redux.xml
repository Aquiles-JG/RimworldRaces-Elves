<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Rimworld Cooking Redux</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <li Class="PatchOperationAdd">
          <xpath>/Defs</xpath>
          <value>
            <ProcessorFramework.ProcessDef>
              <defName>Aq_AloeOilProcess</defName>
              <thingDef>Aq_AloeOil</thingDef>
              <ingredientFilter>
                <thingDefs>
                  <li>Aq_AloeLeaves</li>
                </thingDefs>
              </ingredientFilter>
              <processDays>5</processDays>
              <efficiency>0.3</efficiency>
              <usesTemperature>false</usesTemperature>
              <filledGraphicSuffix>Full</filledGraphicSuffix>
            </ProcessorFramework.ProcessDef>
            
            <ProcessorFramework.ProcessDef>
              <defName>Aq_HenbaneOilProcess</defName>
              <thingDef>Aq_HenbaneOil</thingDef>
              <ingredientFilter>
                <thingDefs>
                  <li>Aq_HenbaneLeaves</li>
                </thingDefs>
              </ingredientFilter>
              <processDays>5</processDays>
              <efficiency>0.3</efficiency>
              <usesTemperature>false</usesTemperature>
              <filledGraphicSuffix>Full</filledGraphicSuffix>
            </ProcessorFramework.ProcessDef>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_Presser"]/comps/li[@Class="ProcessorFramework.CompProperties_Processor"]/processes</xpath>
          <value>
              <li>Aq_AloeOilProcess</li>
              <li>Aq_HenbaneOilProcess</li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ResearchProjectDef[defName="Kara_Culture"]/prerequisites</xpath>
          <value>
            <li>Aq_Spices</li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/RecipeDef[defName="Aq_CookWaybread"]/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>Aq_Oven</li>
              <li>Aq_ElectricOven</li>
            </recipeUsers>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_PeppermintLiquor"]</xpath>
          <value>
            <thingCategories Inherit="False">
              <li>Aq_DrinksAlcoholic</li>
            </thingCategories>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_Extract"]/thingCategories</xpath>
          <value>
            <thingCategories>
              <li>Aq_Musts</li>
            </thingCategories>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_PeppermintPlant"]/plant</xpath>
          <value>
            <sowResearchPrerequisites>
              <li>Aq_Spices</li>
            </sowResearchPrerequisites>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingCategoryDef[defName="Aq_DrinksAlcoholic"]/iconPath</xpath>
          <value>
            <iconPath>Things/Item/Aq_PeppermintLiquor/Aq_PeppermintLiquor_b</iconPath>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/RecipeDef[defName="Aq_CookHotPot"]/fixedIngredientFilter/disallowedThingDefs</xpath>
          <value>
            <li>DE_Blood</li>
            <li>Aq_TrollBlood</li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>/Defs/RecipeDef[defName="Aq_CookHotPot"]/ingredients/li/filter/disallowedThingDefs</xpath>
          <value>
            <li>DE_Blood</li>
            <li>Aq_TrollBlood</li>
          </value>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
