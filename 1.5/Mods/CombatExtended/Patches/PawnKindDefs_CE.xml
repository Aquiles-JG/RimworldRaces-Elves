<?xml version="1.0" encoding="utf-8"?>
<Patch>


	<!-- ========== Give ammo to archers ========== -->
	<Operation Class="PatchOperationAddModExtension">
		<xpath>Defs/PawnKindDef[defName="Drow_GunnerDrow" or defName="Drow_GunnerUFDrow" or defName="Drow_SniperDrow" or defName="Drow_SniperUFDrow"]</xpath>
		<value>
			<li Class="CombatExtended.LoadoutPropertiesExtension">
				<primaryMagazineCount>
					<min>14</min>
					<max>26</max>
				</primaryMagazineCount>
				<forcedSidearm>
					<sidearmMoney>
						<min>120</min>
						<max>250</max>
					</sidearmMoney>
					<weaponTags>
						<li>NeolithicMeleeBasic</li>
						<li>MedievalMeleeDecent</li>
					</weaponTags>
				</forcedSidearm>
			</li>
		</value>
	</Operation>

