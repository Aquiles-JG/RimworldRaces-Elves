<?xml version="1.0" encoding="utf-8" ?>
<Patch>


	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[defName="DE_Pants"]/apparel/wornGraphicPath</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[defName="DE_Pants"]/apparel/wornGraphicPath</xpath>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="DE_Pants"]/apparel</xpath>
		<value>
			<wornGraphicPath>Things/Apparel/DE_Pants/DE_Pants</wornGraphicPath>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="DE_Pants"]</xpath>
		<value>
			<li Class="VisiblePants.ThingDefExtension"/>
		</value>
	</Operation>
	
	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[defName="DE_Loincloth"]/apparel/wornGraphicPath</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[defName="DE_Loincloth"]/apparel/wornGraphicPath</xpath>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="DE_Loincloth"]/apparel</xpath>
		<value>
			<wornGraphicPath>Things/Apparel/DE_Loincloth/DE_Loincloth</wornGraphicPath>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="DE_Loincloth"]</xpath>
		<value>
			<li Class="VisiblePants.ThingDefExtension"/>
		</value>
	</Operation>
	
		

</Patch>