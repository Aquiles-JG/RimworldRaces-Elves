<?xml version="1.0" encoding="utf-8" ?>

<Patch>
  
  <Operation Class="PatchOperationFindMod">
		<mods>
			<li>Ideology</li>
		</mods>
		<match Class="PatchOperationSequence">
			<operations>
  
	<li Class="PatchOperationAdd">
		<xpath>/Defs/PreceptDef[defName = "IdeoRole_MeleeSpecialist"]/requiredMemes</xpath>
    	<value>
      		<li>DrowPrimacy</li>
    	</value>
	</li>
	
	<li Class="PatchOperationReplace">
	<xpath>/Defs/MemeDef[defName = "Structure_TheistEmbodied"]/deityCount</xpath>
    <value>
      <deityCount>1~3</deityCount>
    </value>
	</li>
	
	 <li Class="PatchOperationAdd">
        <xpath>/Defs/PreceptDef[defName="IdeoRole_Moralist"]/roleApparelRequirements</xpath>
        <value>
            <li>
                <anyMemeRequired><li>DrowPrimacy</li></anyMemeRequired>
                <requirement>
                    <bodyPartGroupsMatchAny>
                        <li>FullHead</li>
                         <li>UpperHead</li>
                    </bodyPartGroupsMatchAny>
                    <requiredDefs>
                        <li>DE_PriestessCowl</li>
                    </requiredDefs>
                </requirement>
            </li>
        </value>
    </li>
     <li Class="PatchOperationAdd">
        <xpath>/Defs/PreceptDef[defName="IdeoRole_Moralist"]/roleApparelRequirements</xpath>
        <value>
            <li>
                <anyMemeRequired><li>DrowPrimacy</li></anyMemeRequired>
        		<requirement>
          			<bodyPartGroupsMatchAny>
           				 <li>Torso</li>
            			<li>Neck</li>
            			<li>Shoulders</li>
           				 <li>Arms</li>
            			<li>Legs</li>
          			</bodyPartGroupsMatchAny>
          		<requiredDefs>
           			 <li>DE_PriestessRobe</li>
          		</requiredDefs>
        		</requirement>
            </li>
        </value>
    </li>
     <li Class="PatchOperationAdd">
        <xpath>/Defs/PreceptDef[@Name="PreceptRoleMultiBase"]/roleApparelRequirements</xpath>
        <value>
            <li>
                <anyMemeRequired><li>DrowPrimacy</li></anyMemeRequired>
                <requirement>
                    <bodyPartGroupsMatchAny>
                        <li>FullHead</li>
                         <li>UpperHead</li>
                    </bodyPartGroupsMatchAny>
                    <requiredDefs>
                        <li>DE_Hood</li>
                    </requiredDefs>
                </requirement>
            </li>
        </value>
    </li>
    
			</operations>
		</match>
	</Operation>	
	
  <!-- Hats for Precept Roles -->
	
