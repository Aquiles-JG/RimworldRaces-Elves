<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Blood Venom-->
  <ThingDef ParentName="Aq_UnderdarkDrugBase">
    <defName>Aq_BloodVenom</defName>
    <label>blood venom</label>
    <description>An old dark elf recipe to end an unwanted pregnancy. It is safe to drink it, but causes some mild side effects for two days.</description>
    <graphicData>
      <texPath>Things/Item/Drug/BloodVenom</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <MarketValue>34</MarketValue>
    </statBases>
    <socialPropernessMatters>false</socialPropernessMatters>
    <rotatable>false</rotatable>
    <ingestible>
      <outcomeDoers>
        <li Class="AquilesCore.IngestionOutcomeDoer_RemoveHediff">
          <hediffToRemove>PregnantHuman</hediffToRemove>
        </li>
        <li Class="IngestionOutcomeDoer_GiveHediff">
          	<hediffDef>Aq_Convalescent</hediffDef>
          	<severity>1.0</severity>
        </li>
      </outcomeDoers>
    </ingestible>
    <descriptionHyperlinks>
      	<HediffDef>Aq_Convalescent</HediffDef>
    </descriptionHyperlinks>
    <comps>
      <li Class="CompProperties_Drug">
        <listOrder>3588</listOrder>
        <overdoseSeverityOffset>
          <min>0.01</min>
          <max>0.03</max>
        </overdoseSeverityOffset>
      </li>
    </comps>
  </ThingDef>
</Defs>
