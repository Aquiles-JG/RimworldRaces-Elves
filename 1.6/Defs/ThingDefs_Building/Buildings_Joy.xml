<?xml version="1.0" encoding="utf-8" ?>
<Defs>

 <ThingDef ParentName="FurnitureWithQualityBase">
    <defName>Aq_PuzzleCube</defName>
    <label>puzzle cube</label>
    <description>A drow old game of wit, inteligence and patience. The goal is to get every color in every side without repeting.</description>
    <graphicData>
      <texPath>Things/Item/Aq_PuzzleCube</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <shadowData>
        <volume>(0.65, 0.25, 0.6)</volume>
        <offset>(0, 0, -0.15)</offset>
      </shadowData>
    </graphicData>
    <altitudeLayer>Building</altitudeLayer>
    <rotatable>false</rotatable>
    <socialPropernessMatters>true</socialPropernessMatters>
    <fillPercent>0.20</fillPercent>
    <minTechLevelToBuild>Medieval</minTechLevelToBuild>
    <building>
      <joyKind>Gaming_Cerebral</joyKind>
    </building>
    <researchPrerequisites>
      <li>Kara_Furniture</li>
    </researchPrerequisites>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Mass>2</Mass>
      <Flammability>0.25</Flammability>
      <Beauty>5</Beauty>
      <JoyGainFactor>1.15</JoyGainFactor>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>40</costStuffCount>
    <costList>
    	<Plasteel>10</Plasteel>
    </costList>
    <pathCost>14</pathCost>
    <passability>PassThroughOnly</passability>
    <designationCategory>Joy</designationCategory>
  </ThingDef>

</Defs>