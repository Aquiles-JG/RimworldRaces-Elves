<?xml version="1.0" encoding="utf-8"?>
<Defs>

 	<ThingDef ParentName="AdvancedFermenterBase">
		<defName>Aq_PeppermintBarrel</defName>
		<label>peppermint barrel</label>
		<description>A big barrel meant for aging a high volume of peppermint at once. Any sunlight hitting the barrel may slow down the fermenting, or even stop it.</description>
		<drawerType>MapMeshAndRealTime</drawerType>
		<techLevel>Medieval</techLevel>
		<graphicData>
      		<colorTwo>(138,201,128)</colorTwo>
    	</graphicData>
		<costList>
			<WoodLog>40</WoodLog>
			<Steel>30</Steel>
			<Leather_MDeer>20</Leather_MDeer>
		</costList>
		<statBases>
			<Mass>100</Mass>
			<WorkToBuild>1000</WorkToBuild>
			<MaxHitPoints>200</MaxHitPoints>
			<Flammability>1</Flammability>
			<StyleDominance MayRequire="Ludeon.RimWorld.Ideology">2</StyleDominance>		
		</statBases>
		<constructEffect>ConstructWood</constructEffect>
		<uiIconPath>Things/Building/Production/MetallicBarrel/MetallicBarrel_south</uiIconPath>
		<uiIconColorTwo>(138,201,128)</uiIconColorTwo>
		<researchPrerequisites>
			<li>Kara_Culture</li>
		</researchPrerequisites>
		<comps>
       		<li Class="PipeSystem.CompProperties_AdvancedResourceProcessor">
			  <notWorkingKey>Aq_PeppermintBarrelNotWorking</notWorkingKey>
		 	  <processes>
				<li>Aq_PeppermintProcess</li>
		 	  </processes>
			  <progressBarOffset>(0,0,-0.5)</progressBarOffset>
		 	  <hideSettings>true</hideSettings>
	  		</li>
   		 </comps>
    	<inspectorTabs>
			<li>PipeSystem.ITab_Processor</li>
		</inspectorTabs>
	</ThingDef>
	
	 <PipeSystem.ProcessDef>
		<defName>Aq_PeppermintProcess</defName>
		<label>Brewing herbal liqueur</label>
		<labelOverride>Brew herbal liqueur</labelOverride>
		<spawnOnInteractionCell>true</spawnOnInteractionCell>
		<priorityInBillList>0</priorityInBillList>
		<ingredients>
		<li>
			<thing>Aq_Extract</thing>
			<countNeeded>20</countNeeded>
		</li>
		</ingredients>
		<ticks>360000</ticks>
		<results>
		<li>
			<thing>Aq_PeppermintLiquor</thing>
			<count>15</count>
		</li>
		</results>
		<temperatureRuinable>false</temperatureRuinable>
		<isLightDependingProcess>true</isLightDependingProcess>
		<minLight>-1</minLight>
		<maxLight>0.3</maxLight>
		<autoExtract>false</autoExtract>
		<sustainerWhenWorking>true</sustainerWhenWorking>
		<sustainerDef>Recipe_Brewing</sustainerDef>
  	</PipeSystem.ProcessDef>

</Defs>
