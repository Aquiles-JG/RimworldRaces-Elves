<?xml version="1.0" encoding="utf-8"?>
<Defs>

 <!-- Drow Icebox -->
  <ThingDef ParentName="BuildingBase">
    <defName>Aq_Icebox</defName>
    <label>drow ice box</label>
    <description>A traditional drow un-powered cooler that works by sticking ice in a metal box. If you have enough of these you can bring a room's temperature below freezing. Will run out of ice after only a few days.</description>
    <category>Building</category>
    <thingCategories>
      <li>BuildingsTemperature</li>
    </thingCategories>
    <graphicData>
      <texPath>Things/Building/Aq_Icebox/Aq_Icebox</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
       <damageData>
        <rect>(0.2,0,0.6,0.1)</rect>
      </damageData>
    </graphicData>
    <minifiedDef>MinifiedThing</minifiedDef>
    <drawerType>RealtimeOnly</drawerType>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>25</costStuffCount>
    <costList>
      <Aq_Glowstone>3</Aq_Glowstone>
	  <Plasteel>5</Plasteel>	
    </costList>
    <statBases>
      <WorkToBuild>800</WorkToBuild>
      <Flammability>0.25</Flammability>
      <Cleanliness>0</Cleanliness>
      <Beauty>0</Beauty>
      <MarketValue>235</MarketValue>
	  <Mass>35</Mass>
	  <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">4</StyleDominance>		  
    </statBases>
    <rotatable>false</rotatable>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <selectable>true</selectable>
    <tickerType>Normal</tickerType>
    <fillPercent>0.45</fillPercent>
    <castEdgeShadows>true</castEdgeShadows>	
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <building>
      <destroySound>BuildingDestroyed_Metal_Small</destroySound>
    </building>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <placeWorkers>
      <li>PlaceWorker_CoolerSimple</li>
    </placeWorkers>
    <comps>	
      <li Class="CompProperties_Forbiddable"/>	
      <li Class="CompProperties_Refuelable">  
        <fuelConsumptionRate>10.0</fuelConsumptionRate>
        <fuelCapacity>50.0</fuelCapacity>	
        <fuelFilter><thingDefs><li>Hay</li></thingDefs></fuelFilter>
        <fuelIconPath>Things/Item/Resource/Aq_NoIceBlocks</fuelIconPath>	
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>		
      </li>	
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>-11</heatPerSecond>
        <heatPushMinTemperature>-5</heatPushMinTemperature>		
      </li>
    </comps>
    <dominantStyleCategory>Underdark</dominantStyleCategory>
    <designationCategory>Temperature</designationCategory>
    <tradeTags>
      <li>ExoticMisc</li>
    </tradeTags>
    <researchPrerequisites>
      <li>Kara_Furniture</li>
    </researchPrerequisites>
  </ThingDef>
  
  <ThingDef ParentName="FurnitureBase">
    <defName>DE_Hearth</defName>
    <label>dark pyre</label>
    <description>The dark pyre provides hefty warmth and light to the great halls of the drow temples. People who prefer darklight work best with this light source.</description>
    <graphicData>
      <texPath>Things/Building/DE_Hearth/DE_Hearth</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(2,2)</drawSize>
      <damageData>
        <rect>(0,0.05,1,1.95)</rect>
      </damageData>
    </graphicData>
    <minifiedDef Inherit='False' />
    <thingCategories Inherit='False' />
    <statBases>
      <MaxHitPoints>220</MaxHitPoints>
      <WorkToBuild>100</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>5</Beauty>
      <Mass>15</Mass>
      <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">6</StyleDominance>
    </statBases>
    <category>Building</category>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0.15</fillPercent>
    <size>(2,1)</size>
    <selectable>true</selectable>
    <dominantStyleCategory>Underdark</dominantStyleCategory>
    <designationCategory>Temperature</designationCategory>
    <uiIconPath>Things/Building/DE_Hearth/DE_HearthIcon</uiIconPath>
    <uiIconOffset>(0, -0.04)</uiIconOffset>
    <stuffCategories>
      <li>Stony</li>
    </stuffCategories>
    <costStuffCount>150</costStuffCount>
    <placeWorkers>
      <li>PlaceWorker_Heater</li>
      <li>PlaceWorker_NeverAdjacentUnstandable</li>
    </placeWorkers>
    <canOverlapZones>false</canOverlapZones>
    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>50</pathCost>
    <rotatable>true</rotatable>
    <comps>
      <li>
        <compClass>CompGatherSpot</compClass>
      </li>
      <li Class="CompProperties_Refuelable">
        <fuelConsumptionRate>3.0</fuelConsumptionRate>
        <fuelCapacity>90.0</fuelCapacity>
        <fuelConsumptionPerTickInRain>0.0012</fuelConsumptionPerTickInRain>
        <fuelFilter>
          <thingDefs>
            <li>WoodLog</li>
          </thingDefs>
        </fuelFilter>
        <initialFuelPercent>0</initialFuelPercent>
        <showAllowAutoRefuelToggle>true</showAllowAutoRefuelToggle>
      </li>
      <li Class="CompProperties_Glower">
        <glowRadius>15</glowRadius>
        <glowColor>(78, 226, 229,0)</glowColor>
      </li>
      <li Class="CompProperties_HeatPusher">
        <compClass>CompHeatPusherPowered</compClass>
        <heatPerSecond>28</heatPerSecond>
        <heatPushMaxTemperature>28</heatPushMaxTemperature>
      </li>
      <li Class="CompProperties_DarklightOverlay">
        <fireSize>1.35</fireSize>
        <offset>(0,0,0.18)</offset>
      </li>
      <li Class="CompProperties_Art">
        <nameMaker>NamerArtSarcophagusPlate</nameMaker>
        <descriptionMaker>ArtDescription_Pyre</descriptionMaker>
        <mustBeFullGrave>true</mustBeFullGrave>
      </li>
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Flame</li>
        </focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit">
            <offset>0.14</offset>
          </li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li>
              <li>TorchLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty">Brazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
            </defs>
            <radius>9.9</radius>
            <maxBuildings>8</maxBuildings>
            <offsetPerBuilding>0.02</offsetPerBuilding>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
          </li>
        </offsets>
      </li>
    </comps>
    <inspectorTabs>
      <li>ITab_Art</li>
    </inspectorTabs>
    <building>
      <isMealSource>false</isMealSource>
      <spawnedConceptLearnOpportunity>BillsTab</spawnedConceptLearnOpportunity>
      <artificialForMeditationPurposes>false</artificialForMeditationPurposes>
      <destroySound>BuildingDestroyed_Wood_Small</destroySound>
    </building>
    <researchPrerequisites>
      <li>Kara_Furniture</li>
    </researchPrerequisites>
  </ThingDef>


</Defs>
