<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>Aq_SittingSpot</defName>
    <label>sitting spot</label>
    <description>A designated spot to sit on the floor. Not comfortable.</description>
    <designationCategory>Furniture</designationCategory>
    <graphicData>
      <texPath>Things/Building/SittingSpot</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1,1)</drawSize>
    </graphicData>
    <altitudeLayer>Item</altitudeLayer>
    <passability>Standable</passability>
    <statBases>
      <WorkToBuild>0</WorkToBuild>
      <Comfort>0</Comfort>
    </statBases>
    <scatterableOnMapGen>false</scatterableOnMapGen>
    <useHitPoints>false</useHitPoints>
    <rotatable>false</rotatable>
    <socialPropernessMatters>true</socialPropernessMatters>
    <pathCost>0</pathCost>
    <fillPercent>0.35</fillPercent>
    <building>
      <sowTag>SupportPlantsOnly</sowTag>
      <canPlaceOverImpassablePlant>false</canPlaceOverImpassablePlant>
      <isSittable>true</isSittable>
    </building>
  </ThingDef>
  
  <!-- ======================== Lighting ======================= -->
  <ThingDef ParentName="LampBase">
    <defName>Aq_DarkChandelier</defName>
    <label>dark chandelier</label>
    <description>A dark ceiling mounted chandelier made by drow artisans. Thanks to their amazing craftsmanship with glowstone, these chandeliers are an endless source of darklight.</description>
    <category>Building</category>
    <building>
      <isEdifice>false</isEdifice>
      <isInert>true</isInert>
      <ai_chillDestination>false</ai_chillDestination>
    </building>
    <clearBuildingArea>false</clearBuildingArea>
    <graphicData>
      <texPath>Things/Building/Aq_DarkChandelier</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>Transparent</shaderType>
      <drawRotated>false</drawRotated>
      <drawSize>1.0</drawSize>
    </graphicData>
    <stuffCategories>
      <li>Woody</li>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <Aq_Glowstone>3</Aq_Glowstone>
      <Steel>15</Steel>
    </costList>
    <costStuffCount>50</costStuffCount>
    <rotatable>false</rotatable>
    <altitudeLayer>MoteOverhead</altitudeLayer>
    <passability>Standable</passability>
    <tickerType>Normal</tickerType>
    <drawerType>RealtimeOnly</drawerType>
    <fillPercent>0</fillPercent>
    <pathCost>0</pathCost>
    <statBases>
      <MaxHitPoints>125</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Mass>6</Mass>
      <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">2</StyleDominance>	
    </statBases>
    <selectable>true</selectable>
    <soundImpactDefault>BulletImpact_Ground</soundImpactDefault>
    <leaveResourcesWhenKilled>false</leaveResourcesWhenKilled>
    <killedLeavings>
      <Aq_Glowstone>1</Aq_Glowstone>
    </killedLeavings>
    <drawPlaceWorkersWhileSelected>true</drawPlaceWorkersWhileSelected>
    <constructionSkillPrerequisite>5</constructionSkillPrerequisite>
    <comps Inherit="False">
      <li Class="CompProperties_Glower">
        <glowRadius>12</glowRadius>
        <glowColor>(78, 226, 229, 0)</glowColor>
      </li>
    </comps>
    <designationCategory>Furniture</designationCategory>
    <researchPrerequisites Inherit="False">
      <li>Drow_Furniture</li>
    </researchPrerequisites>
  </ThingDef>
  
  <ThingDef ParentName="TorchLamp">
    <defName>DE_WallLamp</defName>
    <label>wall-mounted glowlamp</label>
    <description>A wall-mounted glowlamp for lighting an area. The power of the glowstone inside makes it an endless source of grim darklight.</description>
    <rotatable>true</rotatable>
    <graphicData>
      <texPath>Things/Building/DE_WallLamp/DE_WallLamp</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>1.1,1.1</drawSize>
      <damageData>
        <rect>(0.35,0.35,0.3,0.3)</rect>
      </damageData>
      <drawOffset>(0, 0.05, 0)</drawOffset>
    </graphicData>
    <uiIconPath>Things/Building/DE_WallLamp/DE_WallLamp_UI</uiIconPath>
    <uiIconScale>0.85</uiIconScale>
    <altitudeLayer>BuildingBelowTop</altitudeLayer>
    <passability>Standable</passability>
    <terrainAffordanceNeeded IsNull="True" />
    <pathCost>0</pathCost>
    <costList>
      <Aq_Glowstone>2</Aq_Glowstone>
      <Steel>10</Steel>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <isAttachment>true</isAttachment>
    </building>
    <statBases>
      <MaxHitPoints>50</MaxHitPoints>
      <StyleDominance MayRequire="Ludeon.RimWorld.Ideology">2</StyleDominance>	
    </statBases>
    <tickerType>Rare</tickerType>
    <placeWorkers>
      <li>Placeworker_AttachedToWall</li>
    </placeWorkers>
    <comps Inherit="False">
      <li Class="VEF.Buildings.CompProperties_GlowerExtended">
        <spawnGlowerInFacedCell>true</spawnGlowerInFacedCell>
        <colorOptions>
          <li>
            <glowRadius>10</glowRadius>
            <glowColor>(78, 226, 229, 0)</glowColor>
          </li>
        </colorOptions>
      </li>
      <li Class="VEF.Buildings.CompProperties_FireOverlayRotatable">
        <texPath>Things/Special/Darklight</texPath>
        <fireSize>0.2</fireSize>
        <northOffset>(0.01, 0, 0.55)</northOffset>
        <southOffset>(0.01, 0, 0)</southOffset>
        <eastOffset>(-0.231, 0, 0.41)</eastOffset>
        <westOffset>(0.231, 0, 0.39)</westOffset>
      </li>
      <li Class="CompProperties_Styleable" />
      <li Class="CompProperties_MeditationFocus">
        <statDef>MeditationFocusStrength</statDef>
        <focusTypes>
          <li>Flame</li>
        </focusTypes>
        <offsets>
          <li Class="FocusStrengthOffset_Lit">
            <offset>0.1</offset>
          </li>
          <li Class="FocusStrengthOffset_BuildingDefsLit">
            <defs>
              <li>Campfire</li>
              <li>TorchLamp</li>
              <li>TorchWallLamp</li>
              <li MayRequire="Ludeon.RimWorld.Royalty,Ludeon.RimWorld.Ideology">DarklightBrazier</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">Darktorch</li>
              <li MayRequire="Ludeon.RimWorld.Ideology">DarktorchFungus</li>
            </defs>
            <offsetPerBuilding>0.01</offsetPerBuilding>
            <radius>9.9</radius>
            <maxBuildings>8</maxBuildings>
            <explanationKey>MeditationFocusPerFlame</explanationKey>
            <explanationKeyAbstract>MeditationFocusPerFlameAbstract</explanationKeyAbstract>
            <drawRingRadius>false</drawRingRadius>
          </li>
        </offsets>
      </li>
    </comps>
    <killedLeavings>
      <Aq_Glowstone>1</Aq_Glowstone>
    </killedLeavings>
    <researchPrerequisites>
      <li>Drow_Furniture</li>
    </researchPrerequisites>
  </ThingDef>
  
</Defs>
