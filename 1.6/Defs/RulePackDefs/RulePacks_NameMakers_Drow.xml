<?xml version="1.0" encoding="utf-8" ?>
<Defs>

 <RulePackDef>
    <defName>NamerDrow</defName>
    <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [Pat][lastName]</li>
		
		<li>firstName(p=1)->[Mnames]</li>
		<li>Pat(p=3)->[Fpat]</li>
		<li>lastName(p=3)->[FamilyList]</li>
      </rulesStrings>
    <rulesFiles>
     	<li>Mnames->Drow_Names/DrowMale</li>
     	<li>Fpat->Drow_Names/Fpat</li>
     	<li>FamilyList->Drow_Names/DrowFamily</li>
     </rulesFiles>
    </rulePack>
  </RulePackDef>
  
  <RulePackDef>
    <defName>NamerDrowFemale</defName>
     <rulePack>
      <rulesStrings>
        <li>r_name->[firstName] [Pat][lastName]</li>
		
		<li>firstName(p=1)->[Fnames]</li>
		<li>Pat(p=3)->[Fpat]</li>
		<li>lastName(p=3)->[FamilyList]</li>
      </rulesStrings>
    <rulesFiles>
     	<li>Fnames->Drow_Names/DrowFemale</li>
     	<li>Fpat->Drow_Names/Fpat</li>
     	<li>FamilyList->Drow_Names/DrowFamily</li>
     </rulesFiles>
    </rulePack>
  </RulePackDef>
  
  <RulePackDef>
    <defName>NamerFactionDrow</defName>
    <rulePack>
      <rulesStrings>
		<li>name->[DrowFaction]'s Outpost</li>
      </rulesStrings>
      <rulesFiles>
		<li>DrowFaction->Words/Drow_Factions</li>
      </rulesFiles>
    </rulePack>
  </RulePackDef>
  
  <RulePackDef>
    <defName>NamerFactionUFDrow</defName>
