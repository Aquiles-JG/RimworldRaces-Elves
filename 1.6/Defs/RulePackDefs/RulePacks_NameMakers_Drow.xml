   <RulePackDef>
    <defName>NamerLeaderDrow</defName>
    <rulePack>
      <rulesStrings>
        <li>r_leaderTitle->[cultureLeaderAdjective] [cultureLeaderNoun]</li>

        <li>cultureLeaderAdjective->blessed</li>
        <li>cultureLeaderAdjective->hallowed</li>
        <li>cultureLeaderAdjective->holy</li>
       
        <li>cultureLeaderNoun->nuschka</li>
        <li>cultureLeaderNoun->matriarch</li>
        <li>cultureLeaderNoun->elder</li>
       
      </rulesStrings>
    </rulePack>
  </RulePackDef>
  
   <RulePackDef>
    <defName>NamerDeityDrow</defName>
    <rulePack>
      <rulesStrings>
        <li>r_deityName->[Deity]</li>
     
        <li>Deity(p=3)->Kara</li>
        <li>Deity->Mormegil</li>
        <li>Deity->Iala</li>
       
      </rulesStrings>
    </rulePack>
  </RulePackDef>
  
  
   <RulePackDef>
    <defName>DeityTypeMakerDrow</defName>
    <rulePack>
      <rulesStrings>
        <li>r_deityType->the [DrowDeity]</li>

        <li>DrowDeity->broadbreasted mother</li>
        <li>DrowDeity->night huntress</li>
        <li>DrowDeity->ravenous maiden</li>
        <li>DrowDeity->masked lady</li>
        <li>DrowDeity->all-mother</li>
        
      </rulesStrings>
    </rulePack>
  </RulePackDef>
  
  
  <RulePackDef>
    <defName>DrowIdeoNamer</defName>
    <rulePack>
      <rulesStrings>
        <li>r_ideoName->[creed] of the [deity]</li>

        <li>r_ideoAdjective->dark elven</li>

        <li>r_memberName->drow</li>
        
        <li>hyphenPrefix->[globalHyphenPrefix]</li>

        <li>globalHyphenPrefix->neo</li>
        <li>globalHyphenPrefix->archaeo</li>
      
        <li>creed->way</li>
        <li>creed->path</li>
        <li>creed->commandment</li>
        <li>creed->canon</li>
        <li>creed->act</li>

        <li>deity->Night Huntress</li>
        <li>deity->Ravenous Maiden</li>
        <li>deity->Broadbreasted Mother</li>
        <li>deity->All-mother</li>
       
      </rulesStrings>
    </rulePack>
  </RulePackDef>
   
  <RulePackDef>
    <defName>DrowNamerFestival</defName>
    <rulePack>
      <rulesStrings>
        <li>r_ritualName->[festivalName]</li>
        <li>festivalName->[festival] of [DrowConcept]</li>

        <li>festival->feast</li>
        <li>festival->ritual</li>
        <li>festival->dance</li>
        <li>festival->orgy</li>
        <li>festival->gathering</li>

        <li>DrowConcept->blood</li>
        <li>DrowConcept->death</li>
        <li>DrowConcept->fury</li>
        <li>DrowConcept->pain</li>
        <li>DrowConcept->faith</li>
        <li>DrowConcept->shadows</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
  
  <!-- Dark Pyre-->
  <RulePackDef>
    <defName>ArtDescription_Pyre</defName>
    <rulePack>
      <rulesStrings>
        <li>physical_description_root->The dark pyre is engraved with a [depiction] of [image]. [desc_sentence_group]</li>
        <li>physical_description_root->The dark pyre bears a [depiction] of [image]. [desc_sentence_group]</li>
        <li>physical_description_root->The dark pyre is engraved with a [depiction] of [image]. [desc_sentence_group]</li>
        <li>physical_description_root->An engraving on this dark pyre [depicts] [image]. [desc_sentence_group]</li>
      </rulesStrings>
    </rulePack>
  </RulePackDef>
  
</Defs>