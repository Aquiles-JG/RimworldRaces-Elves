<Defs>

  <!-- Combatpower +20% for Drow fighters-->
  
  <!-- Bases-->
  <PawnKindDef Name="DrowBase" Abstract="True">
    <race>Human</race>
    <defaultFactionDef>Aq_DrowCity</defaultFactionDef>
    <minGenerationAge>18</minGenerationAge> 
	<invNutrition>2.55</invNutrition>
	<invFoodDef>DE_Waybread</invFoodDef>
	<useFactionXenotypes>true</useFactionXenotypes>	
	<apparelIgnoreSeasons>true</apparelIgnoreSeasons>
	<apparelTags>
		<li>K_Apparel</li>
		<li>ElfApparelBasic</li>
	</apparelTags>
	<apparelDisallowTags>
       	<li>Jester</li>
       	<li>Aq_ElfApparel</li>
       	<li>Aq_ElfMilitary</li>
       	<li>ElfApparelRoyal</li>
       	<li>MedievalMilitaryArmored</li>
       	<li>IndustrialBasic</li>
    </apparelDisallowTags>
    <modExtensions>
      <li Class="VEF.Pawns.PawnKindDefExtension">
        <factionColourApparelPartList>
          <li>Torso</li>
          <li>Torso</li>
          <li>Torso</li>
          <li>Torso</li>
          <li>Legs</li>
        </factionColourApparelPartList>
        <factionColourApparelLayerList>
          <li>OnSkin</li>
          <li>Middle</li>
          <li>Shell</li>
          <li>VFEC_OuterShell</li>
          <li>OnSkin</li>
        </factionColourApparelLayerList>
      </li>
    </modExtensions>
  </PawnKindDef>
  
  <PawnKindDef Name="DrowUFBase" ParentName="DrowBase" Abstract="True">
    <defaultFactionDef>Aq_DrowUnforgiven</defaultFactionDef>
    <modExtensions/>
  </PawnKindDef>
  
  <PawnKindDef Name="DrowEliteBase" ParentName="DrowBase" Abstract="True">
    <minGenerationAge>25</minGenerationAge>
	<apparelTags>
		<li>ElfApparelBasic</li>
