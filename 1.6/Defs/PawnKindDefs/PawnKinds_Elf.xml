<Defs>
  
   <!-- Grey Elves have +20% combatPower-->
  
  <PawnKindDef Name="HighElfBase" Abstract="True">
    	<race>Human</race>
    	<defaultFactionDef>Aq_ElfFactionHigh</defaultFactionDef>
    	<minGenerationAge>18</minGenerationAge>
