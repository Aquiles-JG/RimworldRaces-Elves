<?xml version="1.0" encoding="utf-8" ?>
<Defs>
	
	<ThingDef ParentName="PlantBase">
		<defName>Aq_Plant_Peppermint</defName>
		<label>peppermint plant</label>
		<description>A hybrid mint, a cross between watermint and spearmint.</description>	
		<graphicData>
			<texPath>Things/Plant/Peppermint</texPath>
			<graphicClass>Graphic_Random</graphicClass>
		</graphicData>
		<statBases>
			<MaxHitPoints>65</MaxHitPoints>
			<Nutrition>0.2</Nutrition>
			<Beauty>12</Beauty>
            <BeautyOutdoors>8</BeautyOutdoors>
		</statBases>
		<selectable>true</selectable>
		<pathCost>10</pathCost>
		<ingestible />
		<plant>
			<fertilityMin>0.70</fertilityMin>
			<fertilitySensitivity>1</fertilitySensitivity>
			<dieIfLeafless>true</dieIfLeafless>
			<harvestTag>Standard</harvestTag>
			<harvestedThingDef>Aq_RawPeppermint</harvestedThingDef>
			<harvestYield>4</harvestYield>
			<harvestWork>200</harvestWork>
			<sowTags>
				<li>Ground</li>
				<li>Hydroponic</li>
				<li>Decorative</li>
			</sowTags>
			<topWindExposure>0.1</topWindExposure>
			<growDays>7</growDays>
			<sowMinSkill>7</sowMinSkill>
			<visualSizeRange>0.4~1</visualSizeRange>
			<wildOrder>2</wildOrder>
			<wildClusterRadius>5</wildClusterRadius>
      		<wildClusterWeight>150</wildClusterWeight>
			<wildBiomes>
			  <TemperateForest>0.01</TemperateForest>
			  <TemperateSwamp>0.01</TemperateSwamp>
			  <BorealForest>0.01</BorealForest>
              <ColdBog>0.01</ColdBog>
              <Tundra>0.01</Tundra>
              <Grasslands MayRequire="Ludeon.RimWorld.Odyssey">0.01</Grasslands>
		    </wildBiomes>
			<immatureGraphicPath>Things/Plant/Immature/Peppermint</immatureGraphicPath>
		</plant>
	</ThingDef>
	
