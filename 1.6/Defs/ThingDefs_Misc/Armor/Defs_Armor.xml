<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="ArmorSmithableBase">
    <defName>DE_StuddedArmor</defName>
    <label>drow studded armor</label>
    <description>A studded leather armor is reinforced with close-set rivets or spikes. Meant to be worn under a cloak, offers suitable protection for light combat. The armor was impregnated with a substance that help sustain the pain of wounds.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Dark Elves may wear it.</description>
    <graphicData>
      <texPath>Things/Apparel/DE_StuddedArmor/DE_StuddedArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <recipeMaker>
      <recipeUsers Inherit="False">
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <skillRequirements>
        <Crafting>6</Crafting>
      </skillRequirements>
      <researchPrerequisite>Drow_Smithing</researchPrerequisite>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
    </recipeMaker>
    <costStuffCount>140</costStuffCount>
    <stuffCategories>
      <li>Leathery</li>
    </stuffCategories>
    <equippedStatOffsets>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.15</SlaveSuppressionOffset>
    </equippedStatOffsets>
    <statBases>
      <MaxHitPoints>180</MaxHitPoints>
      <WorkToMake>20000</WorkToMake>
      <Mass>8.5</Mass>
      <StuffEffectMultiplierArmor>0.55</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.99</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.11</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>10</EquipDelay>
    </statBases>
    <apparel>
      <wornGraphicPath>Things/Apparel/DE_StuddedArmor/DE_StuddedArmor</wornGraphicPath>
      <tags>
        <li>K_Apparel</li>
      </tags>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Waist</li>
        <li>Arms</li>
      </bodyPartGroups>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>Underdark</li>
    </tradeTags>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="VEF.Apparels.CompProperties_ApparelHediffs">
        <hediffDefnames>
          <li>Drow_Painstopper</li>
        </hediffDefnames>
      </li>
    </comps>
    <modExtensions>
      <li Class="XenotypeRestrictions.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_DarkElf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
  
  <ThingDef ParentName="ArmorSmithableBase">
    <defName>DE_PlateArmor</defName>
    <label>drow plate armor</label>
    <description>Overlapping solid plates of armor covering the entire body from neck to feet. The armor was impregnated with a substance that helps sustain the pain of wounds and prevents the bleeding.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Dark Elves may wear it.</description>
    <graphicData>
      <texPath>Things/Apparel/DE_PlateArmor/DE_PlateArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <statBases>
      <WorkToMake>50000</WorkToMake>
      <MaxHitPoints>300</MaxHitPoints>
      <Mass>11.5</Mass>
      <Flammability>0.4</Flammability>
      <ArmorRating_Sharp>1.1</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.48</ArmorRating_Blunt>
      <ArmorRating_Heat>0.58</ArmorRating_Heat>
      <Insulation_Cold>32</Insulation_Cold>
      <Insulation_Heat>8</Insulation_Heat>
      <EquipDelay>13</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.1</SocialImpact>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.3</SlaveSuppressionOffset>
      <MoveSpeed>-0.25</MoveSpeed>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Waist</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/DE_PlateArmor/DE_PlateArmor</wornGraphicPath>
      <layers>
        <li>Middle</li>
        <li>Shell</li>
      </layers>
      <tags>
        <li>K_Apparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo MayRequire="Ludeon.RimWorld.Ideology">true</canBeDesiredForIdeo>
    </apparel>
    <recipeMaker>
    <recipeUsers Inherit="False">
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <researchPrerequisite>Drow_Smithing</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
    </recipeMaker>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>Underdark</li>
    </tradeTags>
    <costStuffCount>200</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <Aq_Glowstone>5</Aq_Glowstone>
    </costList>
    <tickerType>Rare</tickerType>
    <comps>
      <li Class="VEF.Apparels.CompProperties_ApparelHediffs">
        <hediffDefnames>
          <li>Drow_HeavyPainstopper</li>
        </hediffDefnames>
      </li>
      <li Class="CompProperties_Biocodable" />
    </comps>
    <modExtensions>
      <li Class="XenotypeRestrictions.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_DarkElf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
  
</Defs>
