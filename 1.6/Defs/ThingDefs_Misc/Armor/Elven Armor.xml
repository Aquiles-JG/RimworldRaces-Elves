<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_ElvenGambeson</defName>
    <label>elven gambeson</label>
    <description>A padded leather gambeson of elvish design.\n\nWhilst not as protective as a plate armor, it doesn't slow the wearer down and provides some insulation from cold and heat.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Elves may wear it.</description>
    <techLevel>Medieval</techLevel>
    <recipeMaker>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
      <researchPrerequisite>Aq_ElvenArmorII</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Apparel/ElvenGambeson/Gambeson</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <stuffCategories>
      <li>Leathery</li>
    </stuffCategories>
    <costStuffCount>200</costStuffCount>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToMake>22000</WorkToMake>
      <Mass>6</Mass>
      <StuffEffectMultiplierArmor>0.65</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>10</EquipDelay>
    </statBases>
    <thingSetMakerTags>
      <li>RewardStandardQualitySuper</li>
    </thingSetMakerTags>
    <costList>
      <Steel>30</Steel>
    </costList>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/ElvenGambeson/Gambeson</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <layers>
        <li>Middle</li>
      </layers>
      <tags>
        <li>Aq_ElfMilitary</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <modExtensions>
      <li Class="AquilesCore.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_Elf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
    <tradeTags>
      <li>Elvendom</li>
    </tradeTags>
  </ThingDef>
  
  <!-- Dragon Rider Armor -->
  <ThingDef ParentName="ArmorSmithableBase">
    <defName>Aq_ElfLordArmor</defName>
    <label>high lord armor</label>
    <description>An armor set crafted by the mastery of the Elves blacksmiths. Lightweight but durable, it ensures mobility during battle.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Elves may wear it.</description>
    <graphicData>
      <texPath>Things/Apparel/ElfLordArmor/ElfLordArmor</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <statBases>
      <WorkToMake>40000</WorkToMake>
      <MaxHitPoints>250</MaxHitPoints>
      <Mass>9</Mass>
      <Flammability>0.4</Flammability>
      <StuffEffectMultiplierArmor>0.78</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>1.0</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>11</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <MoveSpeed>-0.25</MoveSpeed>
      <SocialImpact>0.15</SocialImpact>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.1</SlaveSuppressionOffset>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Waist</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/ElfLordArmor/ElfLordArmor</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <tags>
        <li>Aq_ElfMilitary</li>
        <li>Royal</li>
      </tags>
      <layers>
        <li>Shell</li>
      </layers>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo MayRequire="Ludeon.RimWorld.Ideology">true</canBeDesiredForIdeo>
    </apparel>
    <recipeMaker>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <researchPrerequisite>Aq_ElvenArmorII</researchPrerequisite>
      <unfinishedThingDef>UnfinishedMetallicTechArmor</unfinishedThingDef>
    </recipeMaker>
    <thingCategories>
      <li>ApparelArmor</li>
    </thingCategories>
    <tradeTags>
      <li>Elvendom</li>
    </tradeTags>
    <costStuffCount>125</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <Gold>25</Gold>
    </costList>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <modExtensions>
      <li Class="AquilesCore.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_Elf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
