<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Common -->
  <!-- Elegant dress -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_ElegantDress</defName>
    <label>elegant dress</label>
    <description>An elven dress for the most distinguished events.</description>
    <graphicData>
      <texPath>Things/Apparel/ElegantDress/ElegantDress</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToMake>3000</WorkToMake>
      <Mass>0.15</Mass>
      <EquipDelay>1.5</EquipDelay>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.10</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.2</SocialImpact>
      <TradePriceImprovement>0.10</TradePriceImprovement>
      <SlaveSuppressionOffset MayRequire="Ludeon.RimWorld.Ideology">-0.2</SlaveSuppressionOffset>
    </equippedStatOffsets>
    <costStuffCount>75</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <costList>
      <Gold>1</Gold>
    </costList>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <apparel>
      <layers>
        <li>OnSkin</li>
      </layers>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Legs</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/ElegantDress/ElegantDress</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <gender>Female</gender>
      <tags>
        <li>ElfApparelRoyal</li>
        <li>K_Apparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Elvendom</li>
      <li>Underdark</li>
    </tradeTags>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisite>Aq_Elvendom</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
  <!-- Elven shirt  -->
