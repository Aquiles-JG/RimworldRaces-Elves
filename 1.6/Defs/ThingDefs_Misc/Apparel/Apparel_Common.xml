      <texPath>Things/Apparel/ElvenShirt/ElvenShirt</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>40</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>100</MaxHitPoints>
      <WorkToMake>1600</WorkToMake>
      <Mass>0.25</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.10</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.5</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/ElvenShirt/ElvenShirt</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>ElfApparelBasic</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>Aq_Elvendom</researchPrerequisite>
    </recipeMaker>
    <tradeTags>
      <li>Elvendom</li>
      <li>Underdark</li>
    </tradeTags>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
  </ThingDef>
  <!-- Elven pants  -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_ElvenPants</defName>
    <label>elven pants</label>
    <description>A set of pants made by the elves.</description>
