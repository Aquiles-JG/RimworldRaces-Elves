<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Elven cape-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_ElfApparel_Cape</defName>
    <label>elven cape</label>
    <description>A fashionable cape worn by the elves that uses dark forest colors.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Elves may wear it.</description>
    <graphicData>
      <texPath>Things/Apparel/HoodedCape/Cloak</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>50</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <techLevel>Medieval</techLevel>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>80</MaxHitPoints>
      <WorkToMake>4000</WorkToMake>
      <Mass>1</Mass>
      <StuffEffectMultiplierArmor>0.15</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.25</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.5</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>0.5</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <HuntingStealth>0.2</HuntingStealth>
    </equippedStatOffsets>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/HoodedCape/Cloak</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>Aq_ElfApparel</li>
      </tags>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisite>Aq_ClothingOne</researchPrerequisite>
    </recipeMaker>
    <tradeTags>
      <li>Elvendom</li>
    </tradeTags>
    <modExtensions>
      <li Class="AquilesCore.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_Elf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
  <!-- Elven tunic-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_ElvenTunic</defName>
    <label>elven tunic</label>
    <description>More beautiful and lighter than a human tunic, this elven garment is a great isolation against cold and hot weather.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Elves may wear it.</description>
    <graphicData>
      <texPath>Things/Apparel/ElvenTunic/ElvenTunic</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <costStuffCount>40</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>110</MaxHitPoints>
      <WorkToMake>1800</WorkToMake>
      <Mass>0.25</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.3</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.09</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>1.25</EquipDelay>
    </statBases>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Shoulders</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/ElvenTunic/ElvenTunic</wornGraphicPath>
      <layers>
        <li>OnSkin</li>
      </layers>
      <tags>
        <li>Aq_ElfApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <recipeMaker>
      <researchPrerequisite>Aq_ClothingOne</researchPrerequisite>
    </recipeMaker>
    <tradeTags>
      <li>Elvendom</li>
    </tradeTags>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <modExtensions>
      <li Class="AquilesCore.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_Elf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
  <!-- Elven robe-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_ElvenRobe</defName>
    <label>elven robe</label>
    <description>A simple and elegant robe made by the elves.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Elves may wear it.</description>
    <graphicData>
      <texPath>Things/Apparel/ElvenRobe/ElvenRobe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <costStuffCount>75</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <techLevel>Medieval</techLevel>
    <statBases>
      <MaxHitPoints>120</MaxHitPoints>
      <WorkToMake>7500</WorkToMake>
      <Mass>1.5</Mass>
      <ArmorRating_Blunt>0.035</ArmorRating_Blunt>
      <ArmorRating_Sharp>0.035</ArmorRating_Sharp>
      <Insulation_Cold>3</Insulation_Cold>
      <StuffEffectMultiplierArmor>0.3</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>0.50</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.50</StuffEffectMultiplierInsulation_Heat>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/ElvenRobe/ElvenRobe</wornGraphicPath>
      <layers>
        <li>Shell</li>
        <li>Middle</li>
      </layers>
      <tags>
        <li>Aq_ElfApparel</li>
      </tags>
      <canBeDesiredForIdeo>false</canBeDesiredForIdeo>
    </apparel>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisite>Aq_ClothingOne</researchPrerequisite>
    </recipeMaker>
    <tradeTags>
      <li>Elvendom</li>
    </tradeTags>
    <modExtensions>
      <li Class="AquilesCore.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_Elf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
</Defs>
