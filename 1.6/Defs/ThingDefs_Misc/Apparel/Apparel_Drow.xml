<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Elven cloak -->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_DrowCloak</defName>
    <label>drow cloak</label>
    <description>This cloak covering can keep a wearer warm and dry.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Dark Elves may wear it.</description>
    <graphicData>
      <texPath>Things/Apparel/DrowCloak/DrowCloak</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <costStuffCount>70</costStuffCount>
    <stuffCategories>
      <li>Fabric</li>
      <li>Leathery</li>
    </stuffCategories>
    <statBases>
      <MaxHitPoints>170</MaxHitPoints>
      <WorkToMake>7000</WorkToMake>
      <Mass>2</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>1.00</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>0.10</StuffEffectMultiplierInsulation_Heat>
      <EquipDelay>3</EquipDelay>
    </statBases>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/DrowCloak/DrowCloak</wornGraphicPath>
      <layers>
        <li>Shell</li>
      </layers>
      <tags>
        <li>K_Apparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Worker</li>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <equippedStatOffsets>
      <HuntingStealth>0.15</HuntingStealth>
    </equippedStatOffsets>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <recipeMaker>
      <researchPrerequisite>Drow_Apparel</researchPrerequisite>
    </recipeMaker>
    <tradeTags>
      <li>Underdark</li>
    </tradeTags>
    <modExtensions>
      <li Class="AquilesCore.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_DarkElf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
  
  <!-- Priestess Robe-->
  <ThingDef ParentName="ApparelMakeableBase">
    <defName>Aq_DrowRobe</defName>
    <label>priestess robe</label>
    <description>A long robe of elven design that was blessed in a temple.\n\nIt is more protective than a regular robe and will slightly enchance psychic sensitivity and help dissipate neural heat.\n\n&lt;color=#E5E54C&gt;Gameplay effect:&lt;/color&gt; Only Dark Elves may wear it.</description>
    <techLevel>Medieval</techLevel>
    <recipeMaker>
      <researchPrerequisite>Aq_Elvendom</researchPrerequisite>
      <skillRequirements>
        <Crafting>8</Crafting>
      </skillRequirements>
    </recipeMaker>
    <graphicData>
      <texPath>Things/Apparel/DrowRobe/DrowRobe</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
    </graphicData>
    <stuffCategories>
      <li>Fabric</li>
    </stuffCategories>
    <costStuffCount>100</costStuffCount>
    <statBases>
      <MaxHitPoints>150</MaxHitPoints>
      <WorkToMake>30000</WorkToMake>
      <Mass>1</Mass>
      <StuffEffectMultiplierArmor>0.2</StuffEffectMultiplierArmor>
      <StuffEffectMultiplierInsulation_Cold>1</StuffEffectMultiplierInsulation_Cold>
      <StuffEffectMultiplierInsulation_Heat>1</StuffEffectMultiplierInsulation_Heat>
      <ArmorRating_Sharp>0.15</ArmorRating_Sharp>
      <ArmorRating_Blunt>0.15</ArmorRating_Blunt>
      <EquipDelay>2</EquipDelay>
    </statBases>
    <equippedStatOffsets>
      <SocialImpact>0.05</SocialImpact>
      <PsychicSensitivityOffset MayRequire="Ludeon.RimWorld.Royalty">0.15</PsychicSensitivityOffset>
      <PsychicEntropyRecoveryRate MayRequire="Ludeon.RimWorld.Royalty">0.060</PsychicEntropyRecoveryRate>
    </equippedStatOffsets>
    <costList>
      <Leather_MDeer>20</Leather_MDeer>
      <Aq_Glowstone>3</Aq_Glowstone>
    </costList>
    <thingCategories>
      <li>Apparel</li>
    </thingCategories>
    <apparel>
      <bodyPartGroups>
        <li>Torso</li>
        <li>Neck</li>
        <li>Shoulders</li>
        <li>Arms</li>
        <li>Legs</li>
      </bodyPartGroups>
      <wornGraphicPath>Things/Apparel/DrowRobe/DrowRobe</wornGraphicPath>
      <useWornGraphicMask>true</useWornGraphicMask>
      <gender>Female</gender>
      <layers>
        <li>Shell</li>
        <li>Middle</li>
      </layers>
      <tags>
        <li>K_SacredApparel</li>
      </tags>
      <defaultOutfitTags>
        <li>Soldier</li>
      </defaultOutfitTags>
    </apparel>
    <tradeTags>
      <li>Underdark</li>
    </tradeTags>
    <colorGenerator Class="ColorGenerator_StandardApparel" />
    <modExtensions>
      <li Class="AquilesCore.XenotypeExtension">
        <exclusiveXenotypes>
          <li>Aq_DarkElf</li>
        </exclusiveXenotypes>
      </li>
    </modExtensions>
  </ThingDef>
  
</Defs>
