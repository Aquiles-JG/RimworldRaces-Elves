            <angleOffset>-122</angleOffset>
          </east>
          <south>
            <drawOffset>(-0.34,0,0.60)</drawOffset>
            <angleOffset>-143</angleOffset>
          </south>
          <west>
            <drawOffset>(-0.1,0,0.60)</drawOffset>
            <angleOffset>122</angleOffset>
          </west>
        </weaponDraftedDrawOffsets>
      </li>
    </modExtensions>
