  <!-- War Sickle -->
  <ThingDef ParentName="DrowMeleeWeaponBase">
    <defName>DE_Warsickle</defName>
    <label>warsickle</label>
    <description>Decorated light ceremonial weapon of drow design incrusted with precious metals.</description>
    <graphicData>
      <texPath>Things/MeleeWeapons/DE_Warsickle</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>14000</WorkToMake>
      <Mass>1</Mass>
    </statBases>
    <uiIconScale>1.1</uiIconScale>
    <costList>
      <Steel>60</Steel>
      <Leather_MDeer>10</Leather_MDeer>
    </costList>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>1.7</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>14</power>
        <cooldownTime>1.7</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>12</power>
        <armorPenetration>0.15</armorPenetration>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>Drow_Weapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>5</Crafting>
      </skillRequirements>
    </recipeMaker>
  </ThingDef>
