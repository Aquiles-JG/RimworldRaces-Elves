  <!-- HEAVY WEAPONS-->
  <!--Glaive-->
  <ThingDef ParentName="DrowMeleeWeaponBase">
    <defName>DE_Glaive</defName>
    <label>glaive</label>
    <description>The glaive is a heavy polearm that demands strength and agility and both requirements are met by the sinister ironfists, keepers of the Great Houses.</description>
    <graphicData>
      <texPath>Things/MeleeWeapons/DE_Glaive</texPath>
      <drawSize>1.4</drawSize>
    </graphicData>
    <statBases>
      <WorkToMake>21000</WorkToMake>
      <Mass>2.5</Mass>
    </statBases>
    <weaponTags Inherit="False">
      <li>DrowMeleeHeavy</li>
    </weaponTags>
    <uiIconScale>1.2</uiIconScale>
    <equippedAngleOffset>45</equippedAngleOffset>
    <costStuffCount>80</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <WoodLog>40</WoodLog>
      <Gold>1</Gold>
    </costList>
    <recipeMaker>
      <researchPrerequisite>Drow_Weapons</researchPrerequisite>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
    </recipeMaker>
    <tools>
      <li>
        <label>shaft</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>12</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>23</power>
        <armorPenetration>0.15</armorPenetration>
        <cooldownTime>2.5</cooldownTime>
      </li>
    </tools>
    <modExtensions>
      <li Class="VEF.Things.ThingDefExtension">
        <weaponDraftedDrawOffsets>
          <north>
            <drawOffset>(0.34,0,0.60)</drawOffset>
