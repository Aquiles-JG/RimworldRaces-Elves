  <!-- HOLY WEAPONS: Dagger -->
  <ThingDef ParentName="DrowMeleeWeaponBase">
    <defName>DE_FlameEdge</defName>
    <label>drow dagger</label>
    <description>This is a deadly dagger made by the skill of the Drow master assassins. Its blade has the effect of setting the opponent on fire.</description>
    <graphicData>
      <texPath>Things/MeleeWeapons/DE_Edge</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>15000</WorkToMake>
      <Mass>1</Mass>
      <MarketValue>1220</MarketValue>
    </statBases>
    <weaponTags Inherit="False">
      <li>DrowMeleeSpecial</li>
    </weaponTags>
    <soundInteract>Interact_BladelinkMonoSword</soundInteract>
    <meleeHitSound>MeleeHit_BladelinkMonoSword</meleeHitSound>
    <costList>
      <Steel>50</Steel>
      <Plasteel>20</Plasteel>
      <Leather_MDeer>10</Leather_MDeer>
    </costList>
    <uiIconScale>1</uiIconScale>
    <recipeMaker>
      <researchPrerequisite>Drow_WeaponsII</researchPrerequisite>
      <skillRequirements>
        <Crafting>10</Crafting>
      </skillRequirements>
    </recipeMaker>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>16</power>
        <cooldownTime>1.9</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>16</power>
        <extraMeleeDamages>
          <li>
            <def>Flame</def>
            <amount>9</amount>
            <chance>0.65</chance>
          </li>
        </extraMeleeDamages>
        <armorPenetration>0.15</armorPenetration>
        <cooldownTime>1.9</cooldownTime>
      </li>
    </tools>
    <thingSetMakerTags>
      <li>RewardStandardLowFreq</li>
    </thingSetMakerTags>
    <comps>
      <li Class="CompProperties_Biocodable" />
    </comps>
  </ThingDef>
  <!--== Broadsword ===-->
  <ThingDef ParentName="DrowMeleeWeaponBase">
    <defName>DE_Blade</defName>
