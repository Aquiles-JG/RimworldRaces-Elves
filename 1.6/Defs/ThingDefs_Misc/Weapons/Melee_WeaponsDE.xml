  <!--== Lance ===-->
  <ThingDef ParentName="DrowMeleeWeaponBase">
    <defName>DE_Lance</defName>
    <label>drow lance</label>
    <description>In the dawn of time, it is said that the Drow Goddess was wounded by a drifting spear, so the goddess proscribed the use of this weapon. However, it is also said that She allows her finest champions to wield the Forbidden Lance in battle. The point will make the deepest wounds, so beware!</description>
    <graphicData>
      <texPath>Things/MeleeWeapons/DE_Lance</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>2.25</Mass>
