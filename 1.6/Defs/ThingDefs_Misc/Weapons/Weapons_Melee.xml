<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Base-->
  <ThingDef Name="ElfMeleeWeaponBase" ParentName="BaseMeleeWeapon_Sharp_Quality" Abstract="True">
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <techLevel>Medieval</techLevel>
    <weaponTags>
      <li>ElvenMelee</li>
    </weaponTags>
    <weaponClasses>
      <li>Elf</li>
    </weaponClasses>
    <equippedAngleOffset>-65</equippedAngleOffset>
    <tradeTags>
      <li>ElvenMelee</li>
      <li>Elvendom</li>
    </tradeTags>
  </ThingDef>
  <!-- Elven double knives -->
  <ThingDef ParentName="ElfMeleeWeaponBase">
    <defName>Aq_Elf_WhiteKnives</defName>
    <label>elven knives</label>
    <description>Twin white knives provide fast and deadly melee damage to quickly dispatch many foes from the battlefield.</description>
    <graphicData>
      <texPath>Things/MeleeWeapons/ElvenKnife</texPath>
      <drawSize>0.65</drawSize>
    </graphicData>
    <costList>
      <WoodLog>20</WoodLog>
    </costList>
    <statBases>
      <WorkToMake>24000</WorkToMake>
      <Mass>1</Mass>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>80</costStuffCount>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>16</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>9</power>
        <armorPenetration>0.15</armorPenetration>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <skillRequirements>
        <Crafting>7</Crafting>
      </skillRequirements>
      <researchPrerequisite>Aq_WeaponsOne</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
  <!-- Elven Lhang -->
  <ThingDef ParentName="ElfMeleeWeaponBase">
    <defName>Aq_Elf_Lhang</defName>
    <label>lhang</label>
    <description>Another finesse made by the brilliant craftsmanship of the elven blacksmiths.</description>
    <graphicData>
      <texPath>Things/MeleeWeapons/ElvenLhang</texPath>
      <drawSize>1.1</drawSize>
    </graphicData>
    <costList>
      <WoodLog>10</WoodLog>
    </costList>
    <statBases>
      <WorkToMake>28000</WorkToMake>
      <Mass>1.5</Mass>
    </statBases>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costStuffCount>125</costStuffCount>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
        <power>6</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>14</power>
        <cooldownTime>2.2</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>20</power>
        <armorPenetration>0.2</armorPenetration>
        <cooldownTime>2</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
      <researchPrerequisite>Aq_WeaponsOne</researchPrerequisite>
    </recipeMaker>
  </ThingDef>
  <!-- Bastard Sword-->
  <ThingDef ParentName="ElfMeleeWeaponBase">
    <defName>Aq_Elf_BastardSword</defName>
    <label>bastard sword</label>
    <description>Longer and heavier than a regular sword, the bastard sword provides more damage potential and still be a one-handed weapon.</description>
    <graphicData>
      <texPath>Things/MeleeWeapons/Elf_BastardSword</texPath>
    </graphicData>
    <statBases>
      <WorkToMake>35000</WorkToMake>
      <Mass>2.5</Mass>
    </statBases>
    <costStuffCount>100</costStuffCount>
    <stuffCategories>
      <li>Metallic</li>
    </stuffCategories>
    <costList>
      <Gold>5</Gold>
    </costList>
    <equippedAngleOffset>-45</equippedAngleOffset>
    <weaponTags Inherit="False">
      <li>ElvenMeleeElite</li>
    </weaponTags>
    <tools>
      <li>
        <label>handle</label>
        <capacities>
          <li>Poke</li>
        </capacities>
        <power>8</power>
        <cooldownTime>2</cooldownTime>
      </li>
      <li>
        <label>point</label>
        <capacities>
          <li>Stab</li>
        </capacities>
        <power>16</power>
        <cooldownTime>2.4</cooldownTime>
      </li>
      <li>
        <label>edge</label>
        <capacities>
          <li>Cut</li>
        </capacities>
        <power>28</power>
        <armorPenetration>0.25</armorPenetration>
        <cooldownTime>2.4</cooldownTime>
      </li>
    </tools>
    <recipeMaker>
      <researchPrerequisite>Aq_WeaponsOne</researchPrerequisite>
      <skillRequirements>
        <Crafting>9</Crafting>
      </skillRequirements>
    </recipeMaker>
    <modExtensions>
      <li Class="VEF.Things.ThingDefExtension">
        <weaponDraftedDrawOffsets>
          <north>
            <drawOffset>(-0.2, 0, -0.15)</drawOffset>
            <angleOffset>-205</angleOffset>
          </north>
          <east>
            <drawOffset>(0.45, 0, -0.15)</drawOffset>
            <angleOffset>0</angleOffset>
          </east>
          <south>
            <drawOffset>(0.2, 0, -0.15)</drawOffset>
            <angleOffset>0</angleOffset>
          </south>
          <west>
            <drawOffset>(-0.45, -0.1, -0.15)</drawOffset>
            <angleOffset>0</angleOffset>
          </west>
        </weaponDraftedDrawOffsets>
      </li>
    </modExtensions>
    <comps>
      <li Class="CompProperties_Biocodable" />
    </comps>
  </ThingDef>
</Defs>
