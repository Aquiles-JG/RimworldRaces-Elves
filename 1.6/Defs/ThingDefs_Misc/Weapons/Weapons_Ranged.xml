<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Elven Longbow -->
  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>Aq_Arrow_High</defName>
    <label>elven long arrow</label>
    <graphicData>
      <texPath>Things/Projectile/Arrow_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>ArrowHighVelocity</damageDef>
      <damageAmountBase>18</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>55</speed>
      <armorPenetrationBase>0.15</armorPenetrationBase>
    </projectile>
  </ThingDef>
  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>Aq_Bow_High</defName>
    <label>elven longbow</label>
    <description>The longbow preferred by the gray elves. A powerful long range weapon.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/WeaponRanged/Bow/Aq_GaladhrimBow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <soundInteract>Bow_Recurve</soundInteract>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <Silver>4</Silver>
    </costList>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>0.85</Mass>
      <AccuracyTouch>0.7</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.85</AccuracyMedium>
      <AccuracyLong>0.7</AccuracyLong>
      <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>ElvenRanged</li>
    </weaponTags>
    <weaponClasses>
      <li>Elf</li>
    </weaponClasses>
    <recipeMaker>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <researchPrerequisite>Aq_WeaponsTwo</researchPrerequisite>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Aq_Arrow_High</defaultProjectile>
        <warmupTime>1.6</warmupTime>
        <minRange>1.5</minRange>
        <range>36</range>
        <soundCast>Aq_BowLongbow</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
    <tradeTags>
      <li>ElvenRanged</li>
      <li>Elvendom</li>
    </tradeTags>
  </ThingDef>
  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>Aq_Arrow_Great</defName>
    <label>elven great arrow</label>
