<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <!-- Elven Longbow -->
  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>Aq_Arrow_High</defName>
    <label>elven long arrow</label>
    <graphicData>
      <texPath>Things/Projectile/Arrow_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>ArrowHighVelocity</damageDef>
      <damageAmountBase>18</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <speed>55</speed>
      <armorPenetrationBase>0.15</armorPenetrationBase>
    </projectile>
  </ThingDef>
  
  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>Aq_Bow_High</defName>
    <label>elven longbow</label>
    <description>The longbow preferred by the gray elves. A powerful long range weapon.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/WeaponRanged/Bow/Aq_GaladhrimBow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(1.5,1.5)</drawSize>
    </graphicData>
    <soundInteract>Bow_Recurve</soundInteract>
    <stuffCategories>
      <li>Woody</li>
    </stuffCategories>
    <costStuffCount>60</costStuffCount>
    <costList>
      <Silver>4</Silver>
    </costList>
    <statBases>
      <WorkToMake>20000</WorkToMake>
      <Mass>0.85</Mass>
      <AccuracyTouch>0.7</AccuracyTouch>
      <AccuracyShort>0.85</AccuracyShort>
      <AccuracyMedium>0.85</AccuracyMedium>
      <AccuracyLong>0.7</AccuracyLong>
      <RangedWeapon_Cooldown>1.6</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>ElvenRanged</li>
    </weaponTags>
    <weaponClasses>
      <li>Elf</li>
    </weaponClasses>
    <recipeMaker>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <researchPrerequisite>Aq_WeaponsTwo</researchPrerequisite>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Aq_Arrow_High</defaultProjectile>
        <warmupTime>1.6</warmupTime>
        <minRange>1.5</minRange>
        <range>36</range>
        <soundCast>Aq_BowLongbow</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.6</cooldownTime>
      </li>
    </tools>
    <tradeTags>
      <li>ElvenRanged</li>
      <li>Elvendom</li>
    </tradeTags>
  </ThingDef>
  
  <!-- Elven Greatbow-->
  <ThingDef ParentName="BaseProjectileNeolithic">
    <defName>Aq_Arrow_Great</defName>
    <label>elven great arrow</label>
    <graphicData>
      <texPath>Things/Projectile/Arrow_Small</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <flyOverhead>false</flyOverhead>
      <damageDef>ArrowHighVelocity</damageDef>
      <damageAmountBase>20</damageAmountBase>
      <stoppingPower>1.5</stoppingPower>
      <armorPenetrationBase>0.2</armorPenetrationBase>
      <speed>55</speed>
    </projectile>
  </ThingDef>
  <ThingDef>
    <defName>Aq_Arrow_Fire</defName>
    <label>fire arrow</label>
    <thingClass>FireArrow</thingClass>
    <category>Projectile</category>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Projectile</altitudeLayer>
    <useHitPoints>False</useHitPoints>
    <neverMultiSelect>True</neverMultiSelect>
    <graphicData>
      <texPath>Things/Projectile/FlamebowArrow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <projectile>
      <damageDef>Arrow</damageDef>
      <damageAmountBase>10</damageAmountBase>
      <speed>44</speed>
      <stoppingPower>1.5</stoppingPower>
      <armorPenetrationBase>0.2</armorPenetrationBase>
      <arcHeightFactor>0.90</arcHeightFactor>
      <shadowSize>0.4</shadowSize>
      <ai_IsIncendiary>true</ai_IsIncendiary>
    </projectile>
  </ThingDef>
  
  <ThingDef ParentName="BaseWeaponNeolithic">
    <defName>Aq_Bow_Great</defName>
    <label>elven greatbow</label>
    <description>The elite archers of the gray elves utilize an exceptional longbow that has devestating damage and pinpoint accuracy. This greatbow can fire up to three incendiary arrows.</description>
    <techLevel>Medieval</techLevel>
    <graphicData>
      <texPath>Things/WeaponRanged/Bow/Aq_NoldorinBow</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <drawSize>(2.0,2.0)</drawSize>
    </graphicData>
    <soundInteract>Bow_Recurve</soundInteract>
    <costList>
      <WoodLog>100</WoodLog>
      <Gold>1</Gold>
    </costList>
    <statBases>
      <WorkToMake>30000</WorkToMake>
      <Mass>1.25</Mass>
      <AccuracyTouch>0.85</AccuracyTouch>
      <AccuracyShort>0.75</AccuracyShort>
      <AccuracyMedium>0.75</AccuracyMedium>
      <AccuracyLong>0.85</AccuracyLong>
      <RangedWeapon_Cooldown>1.8</RangedWeapon_Cooldown>
    </statBases>
    <weaponTags>
      <li>ElvenRanged</li>
    </weaponTags>
    <weaponClasses>
      <li>Elf</li>
    </weaponClasses>
    <recipeMaker>
      <recipeUsers>
        <li>ElectricSmithy</li>
        <li>FueledSmithy</li>
      </recipeUsers>
      <researchPrerequisite>Aq_WeaponsTwo</researchPrerequisite>
    </recipeMaker>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
        <defaultProjectile>Aq_Arrow_Great</defaultProjectile>
        <warmupTime>1.8</warmupTime>
        <minRange>2</minRange>
        <range>42</range>
        <soundCast>Aq_BowLongbow</soundCast>
      </li>
    </verbs>
    <tools>
      <li>
        <label>limb</label>
        <capacities>
          <li>Blunt</li>
          <li>Poke</li>
        </capacities>
        <power>9</power>
        <cooldownTime>1.8</cooldownTime>
      </li>
    </tools>
    <comps Inherit="False">
      <li Class="CompProperties_EquippableAbilityReloadable">
        <abilityDef>Aq_FireArrow</abilityDef>
        <maxCharges>3</maxCharges>
        <soundReload>Standard_Reload</soundReload>
        <chargeNoun>Fire arrow</chargeNoun>
        <ammoDef>Chemfuel</ammoDef>
        <ammoCountPerCharge>5</ammoCountPerCharge>
        <baseReloadTicks>60</baseReloadTicks>
      </li>
      <li Class="CompProperties_Forbiddable"/>
      <li Class="CompProperties_Styleable"/>
      <li>
        <compClass>CompQuality</compClass>
      </li>
    </comps>
    <tradeTags>
      <li>ElvenRanged</li>
      <li>Elvendom</li>
    </tradeTags>
  </ThingDef>
  
</Defs>
