    <drawGUIOverlay>true</drawGUIOverlay>
    <statBases>
      <MarketValue>9</MarketValue>
      <Mass>0.5</Mass>
      <MaxHitPoints>60</MaxHitPoints>
      <Flammability>0.7</Flammability>
      <Nutrition>0.1</Nutrition>
      <Beauty>0</Beauty>
      <DeteriorationRate>5</DeteriorationRate>
    </statBases>
    <thingCategories>
      <li>Foods</li>
    </thingCategories>
    <ingestible>
