      <outcomeDoers>
        <li Class="IngestionOutcomeDoer_OffsetHemogen">
          <offset>0.2</offset>
        </li>
      </outcomeDoers>
    </ingestible>
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
    <tradeTags>
      <li>Underdark</li>
    </tradeTags>
  </ThingDef>
  
  <ThingDef ParentName="OrganicProductBase">
    <defName>Aq_TrollBlood</defName>
    <label>troll blood</label>
    <description>Blood from a dead troll, possesses strong regenerative abilities. Can be used to make regeneration potions and protective venoms.</description>
    <graphicData>
      <texPath>Things/Item/Resource/Aq_TrollBlood</texPath>
      <graphicClass>Graphic_StackCount</graphicClass>
      <drawSize>0.90</drawSize>
    </graphicData>
    <socialPropernessMatters>true</socialPropernessMatters>
    <statBases>
      <MarketValue>70</MarketValue>
      <Mass>0.025</Mass>
      <MaxHitPoints>30</MaxHitPoints>
      <Flammability>0.2</Flammability>
      <Nutrition>0.05</Nutrition>
      <DeteriorationRate>1.5</DeteriorationRate>
    </statBases>
    <comps>
      <li Class="CompProperties_Rottable">
        <daysToRotStart>7</daysToRotStart>
        <rotDestroys>true</rotDestroys>
      </li>
