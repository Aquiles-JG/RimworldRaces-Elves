<?xml version="1.0" encoding="UTF-8"?>
<Defs>

<!-- Elves-->
<RecipeDef>
	<defName>MakeAloeVeraOintment</defName>
	<label>prepare aloe ointment</label>
	<description>Prepare an ointment made with aloe vera.</description>
	<jobString>Preparing aloe ointment.</jobString>
	<workSkill>Medicine</workSkill>
	<effectWorking>Cook</effectWorking>
	<workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
	<soundWorking>Recipe_Drug</soundWorking>
	<workAmount>800</workAmount>
	<allowMixingIngredients>true</allowMixingIngredients>
	<ingredients>
	  <li>
		<filter>
		  <thingDefs>
			<li>MedicineHerbal</li>
		  </thingDefs>
		</filter>
		<count>1</count>
	  </li>
	   <li>
		<filter>
		  <thingDefs>
			<li>Aq_AloeOil</li>
		  </thingDefs>
		</filter>
		<count>2</count>
	  </li>
	</ingredients>
	<fixedIngredientFilter>
		<thingDefs>
			<li>MedicineHerbal</li>
			<li>Aq_AloeOil</li>
		</thingDefs>
	</fixedIngredientFilter>
	<products>
		<Aq_AloeOintment>1</Aq_AloeOintment>
	</products>
	<recipeUsers>
	  <li>DrugLab</li>
	</recipeUsers>
	<researchPrerequisite>Aq_ElvenMedicine</researchPrerequisite>
	<skillRequirements>
	  <Intellectual>5</Intellectual>
	  <Medicine>4</Medicine>
	</skillRequirements>
</RecipeDef>

