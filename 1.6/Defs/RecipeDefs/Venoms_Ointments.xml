        <jobString>Making antitoxic venom.</jobString>
        <workSkill>Intellectual</workSkill>
        <effectWorking>Cook</effectWorking>
        <workSpeedStat>DrugSynthesisSpeed</workSpeedStat>
        <soundWorking>Recipe_Drug</soundWorking>
        <workAmount>2000</workAmount>
        <allowMixingIngredients>true</allowMixingIngredients>
        <ingredients>
           <li>
            <filter>
              <thingDefs>
                <li>Aq_RawPeppermint</li>
              </thingDefs>
            </filter>
            <count>40</count>
          </li>
           <li>
            <filter>
              <thingDefs>
                <li>Aq_HenbaneOil</li>
              </thingDefs>
            </filter>
            <count>4</count>
          </li>
        </ingredients>
        <fixedIngredientFilter>
            <thingDefs>
              <li>Aq_RawPeppermint</li>
              <li>Aq_HenbaneOil</li>
            </thingDefs>
        </fixedIngredientFilter>
        <products>
            <Aq_ToxicVenom>2</Aq_ToxicVenom>
        </products>
         <recipeUsers>
          <li>DrugLab</li>
        </recipeUsers>
        <researchPrerequisite>Drow_CultureIII</researchPrerequisite>
        <skillRequirements>
          <Intellectual>4</Intellectual>
          <Medicine>4</Medicine>
        </skillRequirements>
</RecipeDef>

</Defs>
