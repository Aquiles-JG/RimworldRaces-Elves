<?xml version="1.0" encoding="utf-8" ?>
<Defs>


  <RecipeDef>
    <defName>Aq_MakeExtract</defName>
    <label>make herbal extract</label>
    <description>Make herbal extract from peppermint.</description>
    <jobString>Making extract.</jobString>
    <workSpeedStat>DrugCookingSpeed</workSpeedStat>
    <workSkill>Cooking</workSkill>
    <effectWorking>Cook</effectWorking>
    <soundWorking>Recipe_Brewing</soundWorking>
    <workAmount>800</workAmount>
    <targetCountAdjustment>1</targetCountAdjustment>
    <ingredients>
      <li>
        <filter>
          <thingDefs>
            <li>Aq_RawPeppermint</li>
          </thingDefs>
        </filter>
        <count>20</count>
      </li>
    </ingredients>
    <fixedIngredientFilter>
      <thingDefs>
        <li>Aq_RawPeppermint</li>
      </thingDefs>
    </fixedIngredientFilter>
    <recipeUsers>
    	<li>Brewery</li>
    </recipeUsers>
    <products>
      <Aq_Extract>4</Aq_Extract>
    </products>
    <researchPrerequisite>Drow_Culture</researchPrerequisite>
  </RecipeDef>
  
