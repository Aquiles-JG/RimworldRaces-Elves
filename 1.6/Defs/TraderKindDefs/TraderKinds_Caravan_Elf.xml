<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <TraderKindDef>
    <defName>Elf_Caravan_BulkGoods</defName>
    <label>elven goods trader</label>
    <stockGenerators>
      
      <!-- Resources -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>Silver</thingDef>
        <countRange>750~1500</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Aq_AloeLeaves</thingDef>
        <countRange>100~250</countRange>
      </li>
        <li Class="StockGenerator_SingleDef">
        <thingDef>Aq_HenbaneLeaves</thingDef>
        <countRange>100~250</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Cloth</thingDef>
        <countRange>100~350</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>RawBerries</thingDef>
        <countRange>250~300</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>MedicineHerbal</thingDef>
        <countRange>0~10</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Dye</thingDef>
        <countRange>20~30</countRange>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>Textiles</categoryDef>
        <thingDefCountRange>2~3</thingDefCountRange>
        <totalPriceRange>200~600</totalPriceRange>
        <excludedThingDefs>
          <li MayRequire="Ludeon.RimWorld.Anomaly">Leather_Dread</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_Category">
        <categoryDef>FoodRaw</categoryDef>
        <thingDefCountRange>4~5</thingDefCountRange>
        <totalPriceRange>400~600</totalPriceRange>
        <excludedCategories>
          <li>EggsFertilized</li>
        </excludedCategories>
        <excludedThingDefs>
          <li MayRequire="Ludeon.Rimworld.Anomaly">Meat_Twisted</li>
          <li>Meat_Human</li>
        </excludedThingDefs>
      </li>
      <li Class="StockGenerator_MultiDef">
        <thingDefs>
          <li>Chocolate</li>
          <li>Kibble</li>
          <li>DE_Waybread</li>
        </thingDefs>
      </li>  
      <!-- Drugs -->
      <li Class="StockGenerator_Category">
        <categoryDef>Drugs</categoryDef>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
      </li>
      <!-- Apparel -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>BasicClothing</tradeTag>
        <countRange>1~2</countRange>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Elvendom</tradeTag>
        <countRange>2~3</countRange>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
      </li>
      <!-- Animals -->
      <li Class="StockGenerator_Animals">
        <maxWildness>0.70</maxWildness>
        <tradeTagsSell>
          <li>AnimalFarm</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <kindCountRange>2~2</kindCountRange>
        <countRange>3~4</countRange>
        <createMatingPair>
          <li>AnimalFarm</li>
        </createMatingPair>
      </li>

      <!-- Cultist apparel -->
      <li MayRequire="Ludeon.RimWorld.Anomaly" Class="StockGenerator_SingleDef">
        <thingDef>Apparel_CultistMask</thingDef>
        <countRange>-1~2</countRange> <!-- 50% chance for 1~2 -->
      </li>
      <li MayRequire="Ludeon.RimWorld.Anomaly" Class="StockGenerator_SingleDef">
        <thingDef>Apparel_CeremonialCultistMask</thingDef>
        <countRange>-1~2</countRange> <!-- 50% chance for 1~2 -->
      </li>

      <!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>MusicalInstrument</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Elvendom</tag></li>
      
    </stockGenerators>
  </TraderKindDef>

  <TraderKindDef>
    <defName>Elf_Caravan_Exotic</defName>
    <label>enchanted broker</label>
	<commonality>0.7</commonality>
    <stockGenerators>
      <!-- Resources -->
      <li Class="StockGenerator_SingleDef">
            <thingDef>Silver</thingDef>
            <countRange>3000~5000</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
            <thingDef>Gold</thingDef>
            <countRange>40~180</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        	<thingDef>Aq_Glowstone</thingDef>
        	<countRange>2~12</countRange>
      </li>	
      <li Class="StockGenerator_SingleDef">
            <thingDef>RawBerries</thingDef>
            <countRange>40~200</countRange>
      </li>
      <!-- Techprints -->
      <li Class="StockGenerator_Techprints">
      <countChances>
          <li>
            <count>1</count>
            <chance>0.6</chance>
          </li>
      </countChances>
      </li>
      <!-- Apparel -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Elvendom</tradeTag>
        <apparelTag>Aq_ElfApparel</apparelTag>
        <countRange>1~3</countRange>
      </li>
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Elvendom</tradeTag>
        <apparelTag>ElfApparelRoyal</apparelTag>
        <countRange>1~3</countRange>
      </li>
      <!-- Weapons -->
      <li Class="StockGenerator_Tag">
        <tradeTag>Elvendom</tradeTag>
        <thingDefCountRange>2~3</thingDefCountRange>
        <countRange>1</countRange>
      </li>
      <!-- Books -->
      <li Class="StockGenerator_SingleDef">
        <thingDef>TextBook</thingDef>
        <countRange>0~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Schematic</thingDef>
        <countRange>0~2</countRange>
      </li>
      <li Class="StockGenerator_SingleDef">
        <thingDef>Novel</thingDef>
        <countRange>1~2</countRange>
      </li>
      <!-- Art -->
      <li Class="StockGenerator_MarketValue">
        <tradeTag>Art</tradeTag>
        <countRange>4~8</countRange>
      </li>
      <!-- Exotic -->
      <li Class="StockGenerator_Tag">
        <tradeTag>ExoticMisc</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~2</countRange>
        <maxTechLevelGenerate>Medieval</maxTechLevelGenerate>
        <excludedThingDefs>
          <li>MedicineUltratech</li> 
          <li>ComponentSpacer</li> 
        </excludedThingDefs>
        <customCountRanges>
          <Luciferium>7~25</Luciferium>
          <Hyperweave>40~120</Hyperweave>
        </customCountRanges>
      </li>
      <li Class="StockGenerator_Tag">
        <tradeTag>Underdark</tradeTag>
        <thingDefCountRange>1~2</thingDefCountRange>
        <countRange>1~2</countRange>
        <price>Expensive</price>
      </li>
      <!-- Animals -->
      <li Class="StockGenerator_Animals">
        <maxWildness>0.75</maxWildness>
        <checkTemperature>true</checkTemperature>
        <tradeTagsSell>
          <li>AnimalUncommon</li>
          <li>AnimalExotic</li>
        </tradeTagsSell>
        <tradeTagsBuy>
          <li>AnimalExotic</li>
        </tradeTagsBuy>
        <countRange>1~2</countRange>
        <kindCountRange>1~3</kindCountRange>
      </li>
      <!-- Buying -->
      <li Class="StockGenerator_BuyExpensiveSimple" />
      <li Class="StockGenerator_BuyTradeTag"><tag>Art</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>ImplantEmpireCommon</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>ImplantEmpireRoyal</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>PsylinkNeuroformer</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>ExoticBuilding</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>ExoticMisc</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>MusicalInstrument</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>HiTechArmor</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Drugs</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Aq_Gemstones</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Underdark</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Elvendom</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>Dwarfdom</tag></li>
      <li Class="StockGenerator_BuyTradeTag"><tag>AlchemySpProduct</tag></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>Shell_Deadlife</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>VoidSculpture</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>Shard</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>Bioferrite</thingDef></li>
      <li Class="StockGenerator_BuySingleDef" MayRequire="Ludeon.RimWorld.Anomaly"><thingDef>RevenantSpine</thingDef></li>
          
    </stockGenerators>
  </TraderKindDef>
  
</Defs>
