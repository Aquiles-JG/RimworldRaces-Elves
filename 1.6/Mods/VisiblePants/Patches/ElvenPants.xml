<?xml version="1.0" encoding="utf-8" ?>
<Patch>


	<Operation Class="PatchOperationSequence">
		<success>Always</success>
		<operations>
			<li Class="PatchOperationTest">
				<xpath>/Defs/ThingDef[defName="Aq_ElvenPants"]/apparel/wornGraphicPath</xpath>
			</li>
			<li Class="PatchOperationRemove">
				<xpath>/Defs/ThingDef[defName="Aq_ElvenPants"]/apparel/wornGraphicPath</xpath>
			</li>
		</operations>
	</Operation>

	<Operation Class="PatchOperationAdd">
		<xpath>/Defs/ThingDef[defName="Aq_ElvenPants"]/apparel</xpath>
		<value>
			<wornGraphicPath>Things/Apparel/ElvenPants/ElvenPants</wornGraphicPath>
		</value>
	</Operation>

	<Operation Class="PatchOperationAddModExtension">
		<xpath>/Defs/ThingDef[defName="Aq_ElvenPants"]</xpath>
		<value>
			<li Class="VisiblePants.ThingDefExtension"/>
		</value>
	</Operation>	
		

</Patch>