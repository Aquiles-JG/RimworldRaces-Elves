<?xml version="1.0" encoding="utf-8" ?>
<Defs>

	<!-- Base repeated here to avoid loading Elves after Alchemy-->
	<RecipeDef Name="Aq_CuttingGemsBase" Abstract="True">
		<workAmount>1200</workAmount>		
		<workSpeedStat>GeneralLaborSpeed</workSpeedStat>
		<workSkill>Crafting</workSkill>
		<effectWorking>Smith</effectWorking>
		<allowMixingIngredients>true</allowMixingIngredients>	
		<soundWorking>Recipe_Smith</soundWorking>
		<recipeUsers>
			<li>Aq_JewelerTable</li>
		</recipeUsers>
		<skillRequirements>
			<Crafting>6</Crafting>
		</skillRequirements>
		<researchPrerequisite>
			<li>Aq_Jewelry</li>
		</researchPrerequisite>		
	</RecipeDef>
  			
	<RecipeDef ParentName="Aq_CuttingGemsBase">
	<defName>Aq_CuttingGlowstone</defName>
	<label>cut rough glowstone</label>
	<description>cut rough glowstone using a mini band saw and a mercury-based lubricant.</description>
	<jobString>Cutting rough glowstone.</jobString>
	<ingredients>
		<li>
			<filter>
				<thingDefs>
					<li>Aq_RoughGlowstone</li>
				</thingDefs>
			</filter>
			<count>10</count>
		</li>
		<li>
			<filter>
				<thingDefs>
					<li>Aq_Mercury</li>
				</thingDefs>
			</filter>
			<count>2</count>
		</li>
	</ingredients>
	<fixedIngredientFilter>
		<thingDefs>
			<li>Aq_RoughGlowstone</li>
			<li>Aq_Mercury</li>
		</thingDefs>
	</fixedIngredientFilter>
	<products>
		<Aq_Glowstone>10</Aq_Glowstone>
	</products>		
	</RecipeDef>
  			
 
</Defs>