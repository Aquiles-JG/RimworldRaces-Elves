<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>Aquiles Alchemy</li>
    </mods>
    <match Class="PatchOperationSequence">
      <operations>
        <!-- Weapons-->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="DE_RepeaterCB"]/costList</xpath>
          <value>
            <Aq_PrimitiveComponent>1</Aq_PrimitiveComponent>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="DE_RepeaterCB"]/costList/Steel</xpath>
          <value>
            <Aq_Iron>20</Aq_Iron>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "Aq_Bow_Great"]/comps/li[@Class="CompProperties_EquippableAbilityReloadable"]/ammoDef</xpath>
          <value>
            <ammoDef>Aq_Tar</ammoDef>
          </value>
        </li>
        <!-- Scenarios-->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ScenarioDef[defName = "DrowScenario"]/scenario/parts</xpath>
          <value>
            <li Class="ScenPart_ScatterThingsAnywhere">
              <def>ScatterThingsAnywhere</def>
              <thingDef>Aq_Iron</thingDef>
              <count>300</count>
              <allowRoofed>False</allowRoofed>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ScenarioDef[defName = "DrowScenario"]/scenario/parts/li[6]</xpath>
          <value>
            <li Class="ScenPart_StartingThing_Defined">
              <def>StartingThing_Defined</def>
              <thingDef>Aq_PrimitiveComponent</thingDef>
              <count>5</count>
            </li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ScenarioDef[defName = "DrowScenario"]/scenario/parts/li[6]</xpath>
          <value>
            <li Class="ScenPart_StartingThing_Defined">
              <def>StartingThing_Defined</def>
              <thingDef>Aq_Rope</thingDef>
              <count>5</count>
            </li>
          </value>
        </li>
        <!-- Furniture-->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_DarkChandelier"]/costList/Steel</xpath>
          <value>
            <Aq_Glass>3</Aq_Glass>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="DE_WallLamp"]/costList/Steel</xpath>
          <value>
            <Aq_Glass>2</Aq_Glass>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_Icebox"]/costList/Plasteel</xpath>
          <value>
            <Aq_Glass>3</Aq_Glass>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_Icebox"]/comps/li[@Class="CompProperties_Refuelable"]/fuelFilter/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Aq_BlocksIce</li>
            </thingDefs>
          </value>
        </li>
        <!-- Potions-->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "Aq_AloeOil" or defName="Aq_HenbaneOil"]/thingCategories</xpath>
          <value>
            <thingCategories>
              <li>Aq_Oils</li>
            </thingCategories>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/RecipeDef[defName="MakeToxicVenomBulk"]/ingredients/li[1]/filter/thingDefs</xpath>
          <value>
            <thingDefs>
              <li>Aq_Sulfur</li>
            </thingDefs>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/RecipeDef[defName="MakeToxicVenomBulk"]/fixedIngredientFilter/thingDefs/li[1]</xpath>
          <value>
            <li>Aq_Sulfur</li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/RecipeDef[defName="MakeBloodVenom" or defName="MakePlagueVenom" or defName="MakeToxicVenomBulk" or defName = "MakeAloeVeraOintment" or defName="MakeRestorationBalm"]/recipeUsers</xpath>
          <value>
            <recipeUsers>
              <li>Aq_AlchemistFurnace</li>
            </recipeUsers>
          </value>
        </li>
        <!-- Buildings-->
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "Aq_PeppermintBarrel"]/costList/Steel</xpath>
          <value>
            <Aq_Iron>30</Aq_Iron>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName = "Aq_PeppermintBarrel"]/costList/WoodLog</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>Defs/ThingDef[defName = "Aq_PeppermintBarrel"]/constructEffect</xpath>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/ThingDef[defName = "Aq_PeppermintBarrel"]</xpath>
          <value>
            <stuffCategories>
              <li>Woody</li>
            </stuffCategories>
            <costStuffCount>40</costStuffCount>
          </value>
        </li>
        <!-- Anomaly Building-->
        <li MayRequire="Ludeon.RimWorld.Anomaly" Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName="Aq_InhibitingIncense"]/costList/PsychoidLeaves</xpath>
          <value>
            <Aq_Chromium>10</Aq_Chromium>
          </value>
        </li>
        <!-- Traders-->
        <li Class="PatchOperationAdd">
          <xpath>Defs/TraderKindDef[defName="Elf_Caravan_Exotic"]/stockGenerators</xpath>
          <value>
            <li Class="StockGenerator_Tag">
              <tradeTag>AlchemyProduct</tradeTag>
              <thingDefCountRange>2~4</thingDefCountRange>
              <totalPriceRange>150~400</totalPriceRange>
            </li>
            <li Class="StockGenerator_Tag">
              <tradeTag>Elvendom</tradeTag>
              <thingDefCountRange>2~4</thingDefCountRange>
              <totalPriceRange>150~400</totalPriceRange>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/TraderKindDef[defName="Drow_Caravan_Dealer"]/stockGenerators</xpath>
          <value>
            <li Class="StockGenerator_Tag">
              <tradeTag>AlchemyProduct</tradeTag>
              <thingDefCountRange>2~4</thingDefCountRange>
              <totalPriceRange>150~400</totalPriceRange>
            </li>
            <li Class="StockGenerator_Tag">
              <tradeTag>Underdark</tradeTag>
              <thingDefCountRange>2~4</thingDefCountRange>
              <totalPriceRange>150~400</totalPriceRange>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/TraderKindDef[defName="Base_Drow_Standard"]/stockGenerators</xpath>
          <value>
            <li Class="StockGenerator_Tag">
              <tradeTag>AlchemyProduct</tradeTag>
              <thingDefCountRange>2~5</thingDefCountRange>
              <totalPriceRange>150~500</totalPriceRange>
            </li>
            <li Class="StockGenerator_Tag">
              <tradeTag>AlchemySpProduct</tradeTag>
              <thingDefCountRange>2~5</thingDefCountRange>
              <totalPriceRange>150~500</totalPriceRange>
            </li>
          </value>
        </li>
        <li Class="PatchOperationAdd">
          <xpath>Defs/TraderKindDef[defName="Aq_Caravan_Alchemy"]/stockGenerators</xpath>
          <value>
            <li Class="StockGenerator_SingleDef">
              <thingDef>Aq_Glowstone</thingDef>
              <countRange>2~16</countRange>
            </li>
          </value>
        </li>
        <!-- Glowstone-->
        <li Class="PatchOperationAdd">
          <xpath>/Defs/ThingDef[defName="Aq_Glowstone"]/stuffProps/categories</xpath>
          <value>
            <li>Aq_Gemstone</li>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>*/ThingDef[defName="Aq_Glowstone"]/thingCategories</xpath>
          <value>
            <thingCategories>
              <li>Aq_CutGemstones</li>
            </thingCategories>
          </value>
        </li>
        <li Class="PatchOperationReplace">
          <xpath>/Defs/ThingDef[defName = "Aq_MineableGlowstone"]/building/mineableThing</xpath>
          <value>
            <mineableThing>Aq_RoughGlowstone</mineableThing>
          </value>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>/Defs/ThingDef[defName = "Aq_Glowstone"]/deepCommonality</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>/Defs/ThingDef[defName = "Aq_Glowstone"]/deepLumpSizeRange</xpath>
        </li>
        <li Class="PatchOperationRemove">
          <xpath>/Defs/ThingDef[defName = "Aq_Glowstone"]/deepCountPerPortion</xpath>
        </li>
      </operations>
    </match>
  </Operation>
</Patch>
