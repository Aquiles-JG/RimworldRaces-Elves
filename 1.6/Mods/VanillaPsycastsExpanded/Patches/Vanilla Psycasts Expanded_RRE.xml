<?xml version="1.0" encoding="utf-8" ?>
<Patch>

	
<Operation Class="PatchOperationFindMod">
		<mods>
			<li>Vanilla Psycasts Expanded</li>
		</mods>

		<match Class="PatchOperationSequence">
			<operations>
	
				<li Class="PatchOperationAdd">
                    <xpath>/Defs/VanillaPsycastsExpanded.PsycasterPathDef[defName="VPE_Nightstalker"]</xpath>
                    <value>
                    	<lockedReason>Drow only</lockedReason>
                        <requiredBackstoriesAny>
        					<li>
          						<categoryName>DrowBackstory</categoryName>
          						<slot>Childhood</slot>
        					</li>
        					<li>
          						<categoryName>DrowBackstory</categoryName>
          						<slot>Adulthood</slot>
        					</li>
      					</requiredBackstoriesAny>
                    </value>
                </li>
				<li Class="PatchOperationAdd">
            		<xpath>Defs/FactionDef[defName = "Aq_DrowCity"]/pawnGroupMakers</xpath>
            		<value>
               			<li Class="VanillaPsycastsExpanded.PawnGroupMaker_PsycasterRaid">
                  		<kindDef>Combat</kindDef>
                  		<commonality>10</commonality>
                  		<options>
                     		<Drow_SniperDrow>35</Drow_SniperDrow>
							<Drow_ShockDrow>20</Drow_ShockDrow>
        					<Drow_HeavyDrow>40</Drow_HeavyDrow>
							<Drow_CaptainDrow>5</Drow_CaptainDrow>
					 		<Drow_PriestessDrow>0.2</Drow_PriestessDrow>
                  		</options>
                  		</li>
                  	</value>
               </li>
               <li Class="PatchOperationAdd">
            		<xpath>Defs/FactionDef[defName = "Aq_DrowUnforgiven"]/pawnGroupMakers</xpath>
            		<value>
               			<li Class="VanillaPsycastsExpanded.PawnGroupMaker_PsycasterRaid">
                  		<kindDef>Combat</kindDef>
                  		<commonality>10</commonality>
                  		<options>
                     		<Drow_SniperUFDrow>35</Drow_SniperUFDrow>
        					<Drow_HeavyUFDrow>35</Drow_HeavyUFDrow>
        					<Drow_ShockUFDrow>25</Drow_ShockUFDrow>
							<Drow_CaptainUFDrow>5</Drow_CaptainUFDrow>
					 		<Drow_PriestessUFDrow>0.2</Drow_PriestessUFDrow>
                  		</options>
                  		</li>
                  	</value>
               </li>
               <li Class="PatchOperationAdd">
            		<xpath>Defs/FactionDef[@Name = "Aq_ElfFactionBase"]/pawnGroupMakers</xpath>
            		<value>
               			<li Class="VanillaPsycastsExpanded.PawnGroupMaker_PsycasterRaid">
                  		<kindDef>Combat</kindDef>
                  		<commonality>10</commonality>
                  		<options>
                     		 <Aq_ElfGuardHigh>20</Aq_ElfGuardHigh>
          					 <Aq_ElfArcherHigh>10</Aq_ElfArcherHigh>
          					 <Aq_ElfLord>1</Aq_ElfLord>
          					 <Aq_ElfMage>0.2</Aq_ElfMage>
                  		</options>
                  		</li>
                  	</value>
               </li>
                <li Class="PatchOperationAdd">
				<xpath>/Defs/ScenarioDef[defName = "DrowScenario"]/scenario/parts</xpath>
					<value>
						<li Class="ScenPart_ScatterThingsNearPlayerStart">
						<def>ScatterThingsNearPlayerStart</def>
						<thingDef>PsychicAmplifier</thingDef>
						<count>1</count>
						</li>
					</value>
				</li>
				<li Class="PatchOperationAdd">
				<xpath>/Defs/ScenarioDef[defName = "ElfScenario"]/scenario/parts</xpath>
					<value>
						<li Class="ScenPart_ScatterThingsNearPlayerStart">
						<def>ScatterThingsNearPlayerStart</def>
						<thingDef>PsychicAmplifier</thingDef>
						<count>1</count>
						</li>
					</value>
				</li>
				
			</operations>
		</match>
		
</Operation>
	
</Patch>